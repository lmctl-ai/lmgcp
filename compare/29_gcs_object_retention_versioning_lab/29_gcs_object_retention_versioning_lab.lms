# OpenTofu (lmcloud) equivalent for lmgcp example: 29_gcs_object_retention_versioning_lab
# Validates and formats compare/29_gcs_object_retention_versioning_lab/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/29_gcs_object_retention_versioning_lab/workdir");
write_file("build/compare/29_gcs_object_retention_versioning_lab/workdir/main.tf", "resource \"terraform_data\" \"bucket_lmgcp_telemetry_lake_1\" {\n  input = \"google_storage_bucket:lmgcp-telemetry-lake:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"storage_object_lmgcp_telemetry_lake_raw_2026_10_24_shard_00_jsonl_2\" {\n  input = \"google_storage_bucket_object:lmgcp-telemetry-lake/raw/2026-10-24/shard-00.jsonl:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"storage_object_lmgcp_telemetry_lake_raw_2026_10_24_shard_01_jsonl_3\" {\n  input = \"google_storage_bucket_object:lmgcp-telemetry-lake/raw/2026-10-24/shard-01.jsonl:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"storage_object_lmgcp_telemetry_lake_curated_2026_10_24_summary_csv_4\" {\n  input = \"google_storage_bucket_object:lmgcp-telemetry-lake/curated/2026-10-24/summary.csv:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"storage_object_lmgcp_telemetry_lake_tmp_scratch_txt_5\" {\n  input = \"google_storage_bucket_object:lmgcp-telemetry-lake/tmp/scratch.txt:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"29_gcs_object_retention_versioning_lab\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0005\"\n}\n\noutput \"resource_count\" {\n  value = \"5\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/29_gcs_object_retention_versioning_lab/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/29_gcs_object_retention_versioning_lab/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/29_gcs_object_retention_versioning_lab");

  let dir = "build/compare/29_gcs_object_retention_versioning_lab/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 5 && out_ex == "29_gcs_object_retention_versioning_lab" && out_cost == "$0.0005" && out_cnt == "5" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/29_gcs_object_retention_versioning_lab/status.txt", status);
  file_write("build/compare/29_gcs_object_retention_versioning_lab/lmcloud-evidence.json", "{\n  \"example\": \"29_gcs_object_retention_versioning_lab\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.0005,\n  \"estimated_cost_formatted\": \"$0.0005\",\n  \"cost_report\": \"estimated cost: $0.0005 (resources=5, minutes_alive=2, requests=5, cap=$0.05)\",\n  \"resource_count\": 5,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"bucket_lmgcp_telemetry_lake_1\",\n      \"kind\": \"bucket\",\n      \"google_type\": \"google_storage_bucket\",\n      \"subtype\": \"STANDARD\",\n      \"name\": \"lmgcp-telemetry-lake\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"storage_object_lmgcp_telemetry_lake_raw_2026_10_24_shard_00_jsonl_2\",\n      \"kind\": \"storage_object\",\n      \"google_type\": \"google_storage_bucket_object\",\n      \"subtype\": \"application/json\",\n      \"name\": \"lmgcp-telemetry-lake/raw/2026-10-24/shard-00.jsonl\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"storage_object_lmgcp_telemetry_lake_raw_2026_10_24_shard_01_jsonl_3\",\n      \"kind\": \"storage_object\",\n      \"google_type\": \"google_storage_bucket_object\",\n      \"subtype\": \"application/json\",\n      \"name\": \"lmgcp-telemetry-lake/raw/2026-10-24/shard-01.jsonl\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 4,\n      \"ident\": \"storage_object_lmgcp_telemetry_lake_curated_2026_10_24_summary_csv_4\",\n      \"kind\": \"storage_object\",\n      \"google_type\": \"google_storage_bucket_object\",\n      \"subtype\": \"text/csv\",\n      \"name\": \"lmgcp-telemetry-lake/curated/2026-10-24/summary.csv\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 5,\n      \"ident\": \"storage_object_lmgcp_telemetry_lake_tmp_scratch_txt_5\",\n      \"kind\": \"storage_object\",\n      \"google_type\": \"google_storage_bucket_object\",\n      \"subtype\": \"text/plain\",\n      \"name\": \"lmgcp-telemetry-lake/tmp/scratch.txt\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/29_gcs_object_retention_versioning_lab/29_gcs_object_retention_versioning_lab.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/29_gcs_object_retention_versioning_lab/29_gcs_object_retention_versioning_lab.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/29_gcs_object_retention_versioning_lab/status.txt")) == "OK");
println("ok compare/29_gcs_object_retention_versioning_lab - tofu init/plan/apply/destroy verified (resources=5, leftovers=0)");
println("estimated cost: $0.0005 (resources=5, minutes_alive=2, requests=5, cap=$0.05)");
