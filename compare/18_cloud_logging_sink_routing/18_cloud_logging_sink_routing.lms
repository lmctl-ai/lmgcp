# OpenTofu (lmcloud) equivalent for lmgcp example: 18_cloud_logging_sink_routing
# Validates and formats compare/18_cloud_logging_sink_routing/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/18_cloud_logging_sink_routing/workdir");
write_file("build/compare/18_cloud_logging_sink_routing/workdir/main.tf", "resource \"terraform_data\" \"log_entry_lmgcp_audit_log_1\" {\n  input = \"terraform_data:lmgcp-audit-log:lmgcp_test=logging-sink-18\"\n}\n\nresource \"terraform_data\" \"log_sink_lmgcp_siem_sink_2\" {\n  input = \"google_logging_project_sink:lmgcp-siem-sink:lmgcp_test=logging-sink-18\"\n}\n\noutput \"example_id\" {\n  value = \"18_cloud_logging_sink_routing\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0002\"\n}\n\noutput \"resource_count\" {\n  value = \"2\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/18_cloud_logging_sink_routing/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/18_cloud_logging_sink_routing/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/18_cloud_logging_sink_routing");

  let dir = "build/compare/18_cloud_logging_sink_routing/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 2 && out_ex == "18_cloud_logging_sink_routing" && out_cost == "$0.0002" && out_cnt == "2" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/18_cloud_logging_sink_routing/status.txt", status);
  file_write("build/compare/18_cloud_logging_sink_routing/lmcloud-evidence.json", "{\n  \"example\": \"18_cloud_logging_sink_routing\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"logging-sink-18\",\n  \"estimated_cost_usd\": 0.0002,\n  \"estimated_cost_formatted\": \"$0.0002\",\n  \"cost_report\": \"estimated cost: $0.0002 (resources=2, minutes_alive=2, requests=2, cap=$0.05)\",\n  \"resource_count\": 2,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"log_entry_lmgcp_audit_log_1\",\n      \"kind\": \"log_entry\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"WARNING\",\n      \"name\": \"lmgcp-audit-log\",\n      \"lmgcp_test\": \"logging-sink-18\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"log_sink_lmgcp_siem_sink_2\",\n      \"kind\": \"log_sink\",\n      \"google_type\": \"google_logging_project_sink\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-siem-sink\",\n      \"lmgcp_test\": \"logging-sink-18\",\n      \"cost_usd\": 0.0001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/18_cloud_logging_sink_routing/18_cloud_logging_sink_routing.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/18_cloud_logging_sink_routing/18_cloud_logging_sink_routing.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/18_cloud_logging_sink_routing/status.txt")) == "OK");
println("ok compare/18_cloud_logging_sink_routing - tofu init/plan/apply/destroy verified (resources=2, leftovers=0)");
println("estimated cost: $0.0002 (resources=2, minutes_alive=2, requests=2, cap=$0.05)");
