# OpenTofu (lmcloud) equivalent for lmgcp example: 11_cloud_sql_ha_backup_posture
# Validates and formats compare/11_cloud_sql_ha_backup_posture/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/11_cloud_sql_ha_backup_posture/workdir");
write_file("build/compare/11_cloud_sql_ha_backup_posture/workdir/main.tf", "resource \"terraform_data\" \"sql_instance_lmgcp_sql_demo_1\" {\n  input = \"google_sql_database_instance:lmgcp-sql-demo:lmgcp_test=sql-posture-11\"\n}\n\noutput \"example_id\" {\n  value = \"11_cloud_sql_ha_backup_posture\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0027\"\n}\n\noutput \"resource_count\" {\n  value = \"1\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/11_cloud_sql_ha_backup_posture/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/11_cloud_sql_ha_backup_posture/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/11_cloud_sql_ha_backup_posture");

  let dir = "build/compare/11_cloud_sql_ha_backup_posture/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 1 && out_ex == "11_cloud_sql_ha_backup_posture" && out_cost == "$0.0027" && out_cnt == "1" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/11_cloud_sql_ha_backup_posture/status.txt", status);
  file_write("build/compare/11_cloud_sql_ha_backup_posture/lmcloud-evidence.json", "{\n  \"example\": \"11_cloud_sql_ha_backup_posture\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"sql-posture-11\",\n  \"estimated_cost_usd\": 0.0027,\n  \"estimated_cost_formatted\": \"$0.0027\",\n  \"cost_report\": \"estimated cost: $0.0027 (resources=1, minutes_alive=10, requests=1, cap=$0.05)\",\n  \"resource_count\": 1,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"sql_instance_lmgcp_sql_demo_1\",\n      \"kind\": \"sql_instance\",\n      \"google_type\": \"google_sql_database_instance\",\n      \"subtype\": \"db-f1-micro\",\n      \"name\": \"lmgcp-sql-demo\",\n      \"lmgcp_test\": \"sql-posture-11\",\n      \"cost_usd\": 0.0027\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/11_cloud_sql_ha_backup_posture/11_cloud_sql_ha_backup_posture.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/11_cloud_sql_ha_backup_posture/11_cloud_sql_ha_backup_posture.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/11_cloud_sql_ha_backup_posture/status.txt")) == "OK");
println("ok compare/11_cloud_sql_ha_backup_posture - tofu init/plan/apply/destroy verified (resources=1, leftovers=0)");
println("estimated cost: $0.0027 (resources=1, minutes_alive=10, requests=1, cap=$0.05)");
