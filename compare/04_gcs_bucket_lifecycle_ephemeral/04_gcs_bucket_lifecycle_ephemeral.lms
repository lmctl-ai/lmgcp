# OpenTofu (lmcloud) equivalent for lmgcp example: 04_gcs_bucket_lifecycle_ephemeral
# Validates and formats compare/04_gcs_bucket_lifecycle_ephemeral/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/04_gcs_bucket_lifecycle_ephemeral/workdir");
write_file("build/compare/04_gcs_bucket_lifecycle_ephemeral/workdir/main.tf", "resource \"terraform_data\" \"bucket_lmgcp_lifecycle_demo_1\" {\n  input = \"google_storage_bucket:lmgcp-lifecycle-demo:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"storage_object_lmgcp_lifecycle_demo_2026_10_events_01_json_2\" {\n  input = \"google_storage_bucket_object:lmgcp-lifecycle-demo/2026/10/events-01.json:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"storage_object_lmgcp_lifecycle_demo_2026_10_events_02_json_3\" {\n  input = \"google_storage_bucket_object:lmgcp-lifecycle-demo/2026/10/events-02.json:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"04_gcs_bucket_lifecycle_ephemeral\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0003\"\n}\n\noutput \"resource_count\" {\n  value = \"3\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/04_gcs_bucket_lifecycle_ephemeral/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/04_gcs_bucket_lifecycle_ephemeral/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/04_gcs_bucket_lifecycle_ephemeral");

  let dir = "build/compare/04_gcs_bucket_lifecycle_ephemeral/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 3 && out_ex == "04_gcs_bucket_lifecycle_ephemeral" && out_cost == "$0.0003" && out_cnt == "3" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/04_gcs_bucket_lifecycle_ephemeral/status.txt", status);
  file_write("build/compare/04_gcs_bucket_lifecycle_ephemeral/lmcloud-evidence.json", "{\n  \"example\": \"04_gcs_bucket_lifecycle_ephemeral\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.0003,\n  \"estimated_cost_formatted\": \"$0.0003\",\n  \"cost_report\": \"estimated cost: $0.0003 (resources=3, minutes_alive=2, requests=3, cap=$0.05)\",\n  \"resource_count\": 3,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"bucket_lmgcp_lifecycle_demo_1\",\n      \"kind\": \"bucket\",\n      \"google_type\": \"google_storage_bucket\",\n      \"subtype\": \"STANDARD\",\n      \"name\": \"lmgcp-lifecycle-demo\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"storage_object_lmgcp_lifecycle_demo_2026_10_events_01_json_2\",\n      \"kind\": \"storage_object\",\n      \"google_type\": \"google_storage_bucket_object\",\n      \"subtype\": \"application/json\",\n      \"name\": \"lmgcp-lifecycle-demo/2026/10/events-01.json\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"storage_object_lmgcp_lifecycle_demo_2026_10_events_02_json_3\",\n      \"kind\": \"storage_object\",\n      \"google_type\": \"google_storage_bucket_object\",\n      \"subtype\": \"application/json\",\n      \"name\": \"lmgcp-lifecycle-demo/2026/10/events-02.json\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/04_gcs_bucket_lifecycle_ephemeral/04_gcs_bucket_lifecycle_ephemeral.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/04_gcs_bucket_lifecycle_ephemeral/04_gcs_bucket_lifecycle_ephemeral.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/04_gcs_bucket_lifecycle_ephemeral/status.txt")) == "OK");
println("ok compare/04_gcs_bucket_lifecycle_ephemeral - tofu init/plan/apply/destroy verified (resources=3, leftovers=0)");
println("estimated cost: $0.0003 (resources=3, minutes_alive=2, requests=3, cap=$0.05)");
