# OpenTofu (lmcloud) equivalent for lmgcp example: 19_cloud_monitoring_slo_burn_rate
# Validates and formats compare/19_cloud_monitoring_slo_burn_rate/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/19_cloud_monitoring_slo_burn_rate/workdir");
write_file("build/compare/19_cloud_monitoring_slo_burn_rate/workdir/main.tf", "resource \"terraform_data\" \"alert_policy_lmgcp_slo_latency_alert_1\" {\n  input = \"google_monitoring_alert_policy:lmgcp-slo-latency-alert:lmgcp_test=monitoring-slo-19\"\n}\n\noutput \"example_id\" {\n  value = \"19_cloud_monitoring_slo_burn_rate\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0002\"\n}\n\noutput \"resource_count\" {\n  value = \"1\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/19_cloud_monitoring_slo_burn_rate/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/19_cloud_monitoring_slo_burn_rate/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/19_cloud_monitoring_slo_burn_rate");

  let dir = "build/compare/19_cloud_monitoring_slo_burn_rate/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 1 && out_ex == "19_cloud_monitoring_slo_burn_rate" && out_cost == "$0.0002" && out_cnt == "1" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/19_cloud_monitoring_slo_burn_rate/status.txt", status);
  file_write("build/compare/19_cloud_monitoring_slo_burn_rate/lmcloud-evidence.json", "{\n  \"example\": \"19_cloud_monitoring_slo_burn_rate\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"monitoring-slo-19\",\n  \"estimated_cost_usd\": 0.0002,\n  \"estimated_cost_formatted\": \"$0.0002\",\n  \"cost_report\": \"estimated cost: $0.0002 (resources=1, minutes_alive=2, requests=1, cap=$0.05)\",\n  \"resource_count\": 1,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"alert_policy_lmgcp_slo_latency_alert_1\",\n      \"kind\": \"alert_policy\",\n      \"google_type\": \"google_monitoring_alert_policy\",\n      \"subtype\": \"run.googleapis.com/request_latencies_p95_ms\",\n      \"name\": \"lmgcp-slo-latency-alert\",\n      \"lmgcp_test\": \"monitoring-slo-19\",\n      \"cost_usd\": 0.0002\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/19_cloud_monitoring_slo_burn_rate/19_cloud_monitoring_slo_burn_rate.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/19_cloud_monitoring_slo_burn_rate/19_cloud_monitoring_slo_burn_rate.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/19_cloud_monitoring_slo_burn_rate/status.txt")) == "OK");
println("ok compare/19_cloud_monitoring_slo_burn_rate - tofu init/plan/apply/destroy verified (resources=1, leftovers=0)");
println("estimated cost: $0.0002 (resources=1, minutes_alive=2, requests=1, cap=$0.05)");
