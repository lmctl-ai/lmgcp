# OpenTofu (lmcloud) equivalent for lmgcp example: 14_kms_key_rotation_posture
# Validates and formats compare/14_kms_key_rotation_posture/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/14_kms_key_rotation_posture/workdir");
write_file("build/compare/14_kms_key_rotation_posture/workdir/main.tf", "resource \"terraform_data\" \"kms_key_lmgcp_ephemeral_cmek_1\" {\n  input = \"google_kms_crypto_key:lmgcp-ephemeral-cmek:lmgcp_test=kms-posture-14\"\n}\n\noutput \"example_id\" {\n  value = \"14_kms_key_rotation_posture\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0010\"\n}\n\noutput \"resource_count\" {\n  value = \"1\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/14_kms_key_rotation_posture/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/14_kms_key_rotation_posture/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/14_kms_key_rotation_posture");

  let dir = "build/compare/14_kms_key_rotation_posture/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 1 && out_ex == "14_kms_key_rotation_posture" && out_cost == "$0.0010" && out_cnt == "1" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/14_kms_key_rotation_posture/status.txt", status);
  file_write("build/compare/14_kms_key_rotation_posture/lmcloud-evidence.json", "{\n  \"example\": \"14_kms_key_rotation_posture\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"kms-posture-14\",\n  \"estimated_cost_usd\": 0.001,\n  \"estimated_cost_formatted\": \"$0.0010\",\n  \"cost_report\": \"estimated cost: $0.0010 (resources=1, minutes_alive=5, requests=1, cap=$0.05)\",\n  \"resource_count\": 1,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"kms_key_lmgcp_ephemeral_cmek_1\",\n      \"kind\": \"kms_key\",\n      \"google_type\": \"google_kms_crypto_key\",\n      \"subtype\": \"ENCRYPT_DECRYPT\",\n      \"name\": \"lmgcp-ephemeral-cmek\",\n      \"lmgcp_test\": \"kms-posture-14\",\n      \"cost_usd\": 0.001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/14_kms_key_rotation_posture/14_kms_key_rotation_posture.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/14_kms_key_rotation_posture/14_kms_key_rotation_posture.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/14_kms_key_rotation_posture/status.txt")) == "OK");
println("ok compare/14_kms_key_rotation_posture - tofu init/plan/apply/destroy verified (resources=1, leftovers=0)");
println("estimated cost: $0.0010 (resources=1, minutes_alive=5, requests=1, cap=$0.05)");
