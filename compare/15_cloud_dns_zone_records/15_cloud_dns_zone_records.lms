# OpenTofu (lmcloud) equivalent for lmgcp example: 15_cloud_dns_zone_records
# Validates and formats compare/15_cloud_dns_zone_records/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/15_cloud_dns_zone_records/workdir");
write_file("build/compare/15_cloud_dns_zone_records/workdir/main.tf", "resource \"terraform_data\" \"dns_zone_lmgcp_dns_zone_1\" {\n  input = \"google_dns_managed_zone:lmgcp-dns-zone:lmgcp_test=dns-audit-15\"\n}\n\nresource \"terraform_data\" \"dns_record_lmgcp_dns_zone_api_sandbox_gcp_masked_example_2\" {\n  input = \"google_dns_record_set:lmgcp-dns-zone/api.sandbox.gcp-masked.example.:lmgcp_test=dns-audit-15\"\n}\n\nresource \"terraform_data\" \"dns_record_lmgcp_dns_zone_api_sandbox_gcp_masked_example_3\" {\n  input = \"google_dns_record_set:lmgcp-dns-zone/api.sandbox.gcp-masked.example.:lmgcp_test=dns-audit-15\"\n}\n\noutput \"example_id\" {\n  value = \"15_cloud_dns_zone_records\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0009\"\n}\n\noutput \"resource_count\" {\n  value = \"3\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/15_cloud_dns_zone_records/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/15_cloud_dns_zone_records/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/15_cloud_dns_zone_records");

  let dir = "build/compare/15_cloud_dns_zone_records/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 3 && out_ex == "15_cloud_dns_zone_records" && out_cost == "$0.0009" && out_cnt == "3" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/15_cloud_dns_zone_records/status.txt", status);
  file_write("build/compare/15_cloud_dns_zone_records/lmcloud-evidence.json", "{\n  \"example\": \"15_cloud_dns_zone_records\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"dns-audit-15\",\n  \"estimated_cost_usd\": 0.0009,\n  \"estimated_cost_formatted\": \"$0.0009\",\n  \"cost_report\": \"estimated cost: $0.0009 (resources=3, minutes_alive=5, requests=3, cap=$0.05)\",\n  \"resource_count\": 3,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"dns_zone_lmgcp_dns_zone_1\",\n      \"kind\": \"dns_zone\",\n      \"google_type\": \"google_dns_managed_zone\",\n      \"subtype\": \"public\",\n      \"name\": \"lmgcp-dns-zone\",\n      \"lmgcp_test\": \"dns-audit-15\",\n      \"cost_usd\": 0.0007\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"dns_record_lmgcp_dns_zone_api_sandbox_gcp_masked_example_2\",\n      \"kind\": \"dns_record\",\n      \"google_type\": \"google_dns_record_set\",\n      \"subtype\": \"A\",\n      \"name\": \"lmgcp-dns-zone/api.sandbox.gcp-masked.example.\",\n      \"lmgcp_test\": \"dns-audit-15\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"dns_record_lmgcp_dns_zone_api_sandbox_gcp_masked_example_3\",\n      \"kind\": \"dns_record\",\n      \"google_type\": \"google_dns_record_set\",\n      \"subtype\": \"TXT\",\n      \"name\": \"lmgcp-dns-zone/api.sandbox.gcp-masked.example.\",\n      \"lmgcp_test\": \"dns-audit-15\",\n      \"cost_usd\": 0.0001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/15_cloud_dns_zone_records/15_cloud_dns_zone_records.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/15_cloud_dns_zone_records/15_cloud_dns_zone_records.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/15_cloud_dns_zone_records/status.txt")) == "OK");
println("ok compare/15_cloud_dns_zone_records - tofu init/plan/apply/destroy verified (resources=3, leftovers=0)");
println("estimated cost: $0.0009 (resources=3, minutes_alive=5, requests=3, cap=$0.05)");
