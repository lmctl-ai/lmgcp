# OpenTofu (lmcloud) equivalent for lmgcp example: 07_cleanup_sweeper_dry_run
# Validates and formats compare/07_cleanup_sweeper_dry_run/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/07_cleanup_sweeper_dry_run/workdir");
write_file("build/compare/07_cleanup_sweeper_dry_run/workdir/main.tf", "resource \"terraform_data\" \"compute_instance_lmgcp_stale_vm_48h_1\" {\n  input = \"google_compute_instance:lmgcp-stale-vm-48h:lmgcp_test=sweeper-demo-07\"\n}\n\nresource \"terraform_data\" \"bucket_lmgcp_stale_bkt_36h_2\" {\n  input = \"google_storage_bucket:lmgcp-stale-bkt-36h:lmgcp_test=sweeper-demo-07\"\n}\n\nresource \"terraform_data\" \"pubsub_topic_lmgcp_recent_topic_8h_3\" {\n  input = \"google_pubsub_topic:lmgcp-recent-topic-8h:lmgcp_test=sweeper-demo-07\"\n}\n\nresource \"terraform_data\" \"cloud_run_lmgcp_fresh_svc_1h_4\" {\n  input = \"google_cloud_run_v2_service:lmgcp-fresh-svc-1h:lmgcp_test=sweeper-demo-07\"\n}\n\noutput \"example_id\" {\n  value = \"07_cleanup_sweeper_dry_run\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0015\"\n}\n\noutput \"resource_count\" {\n  value = \"4\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/07_cleanup_sweeper_dry_run/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/07_cleanup_sweeper_dry_run/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/07_cleanup_sweeper_dry_run");

  let dir = "build/compare/07_cleanup_sweeper_dry_run/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 4 && out_ex == "07_cleanup_sweeper_dry_run" && out_cost == "$0.0015" && out_cnt == "4" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/07_cleanup_sweeper_dry_run/status.txt", status);
  file_write("build/compare/07_cleanup_sweeper_dry_run/lmcloud-evidence.json", "{\n  \"example\": \"07_cleanup_sweeper_dry_run\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"sweeper-demo-07\",\n  \"estimated_cost_usd\": 0.0015,\n  \"estimated_cost_formatted\": \"$0.0015\",\n  \"cost_report\": \"estimated cost: $0.0015 (resources=4, minutes_alive=5, requests=4, cap=$0.05)\",\n  \"resource_count\": 4,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"compute_instance_lmgcp_stale_vm_48h_1\",\n      \"kind\": \"compute_instance\",\n      \"google_type\": \"google_compute_instance\",\n      \"subtype\": \"e2-micro\",\n      \"name\": \"lmgcp-stale-vm-48h\",\n      \"lmgcp_test\": \"sweeper-demo-07\",\n      \"cost_usd\": 0.0009\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"bucket_lmgcp_stale_bkt_36h_2\",\n      \"kind\": \"bucket\",\n      \"google_type\": \"google_storage_bucket\",\n      \"subtype\": \"STANDARD\",\n      \"name\": \"lmgcp-stale-bkt-36h\",\n      \"lmgcp_test\": \"sweeper-demo-07\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"pubsub_topic_lmgcp_recent_topic_8h_3\",\n      \"kind\": \"pubsub_topic\",\n      \"google_type\": \"google_pubsub_topic\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-recent-topic-8h\",\n      \"lmgcp_test\": \"sweeper-demo-07\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 4,\n      \"ident\": \"cloud_run_lmgcp_fresh_svc_1h_4\",\n      \"kind\": \"cloud_run\",\n      \"google_type\": \"google_cloud_run_v2_service\",\n      \"subtype\": \"us-central1\",\n      \"name\": \"lmgcp-fresh-svc-1h\",\n      \"lmgcp_test\": \"sweeper-demo-07\",\n      \"cost_usd\": 0.0004\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/07_cleanup_sweeper_dry_run/07_cleanup_sweeper_dry_run.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/07_cleanup_sweeper_dry_run/07_cleanup_sweeper_dry_run.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/07_cleanup_sweeper_dry_run/status.txt")) == "OK");
println("ok compare/07_cleanup_sweeper_dry_run - tofu init/plan/apply/destroy verified (resources=4, leftovers=0)");
println("estimated cost: $0.0015 (resources=4, minutes_alive=5, requests=4, cap=$0.05)");
