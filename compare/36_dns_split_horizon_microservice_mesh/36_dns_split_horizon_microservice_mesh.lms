# OpenTofu (lmcloud) equivalent for lmgcp example: 36_dns_split_horizon_microservice_mesh
# Validates and formats compare/36_dns_split_horizon_microservice_mesh/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/36_dns_split_horizon_microservice_mesh/workdir");
write_file("build/compare/36_dns_split_horizon_microservice_mesh/workdir/main.tf", "resource \"terraform_data\" \"dns_zone_lmgcp_mesh_internal_1\" {\n  input = \"google_dns_managed_zone:lmgcp-mesh-internal:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"dns_record_lmgcp_mesh_internal_checkout_mesh_lmgcp_internal_2\" {\n  input = \"google_dns_record_set:lmgcp-mesh-internal/checkout.mesh.lmgcp.internal.:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"dns_record_lmgcp_mesh_internal_payments_mesh_lmgcp_internal_3\" {\n  input = \"google_dns_record_set:lmgcp-mesh-internal/payments.mesh.lmgcp.internal.:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"dns_record_lmgcp_mesh_internal__policy_mesh_lmgcp_internal_4\" {\n  input = \"google_dns_record_set:lmgcp-mesh-internal/_Policy.mesh.lmgcp.internal.:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"36_dns_split_horizon_microservice_mesh\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0010\"\n}\n\noutput \"resource_count\" {\n  value = \"4\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/36_dns_split_horizon_microservice_mesh/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/36_dns_split_horizon_microservice_mesh/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/36_dns_split_horizon_microservice_mesh");

  let dir = "build/compare/36_dns_split_horizon_microservice_mesh/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 4 && out_ex == "36_dns_split_horizon_microservice_mesh" && out_cost == "$0.0010" && out_cnt == "4" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/36_dns_split_horizon_microservice_mesh/status.txt", status);
  file_write("build/compare/36_dns_split_horizon_microservice_mesh/lmcloud-evidence.json", "{\n  \"example\": \"36_dns_split_horizon_microservice_mesh\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.001,\n  \"estimated_cost_formatted\": \"$0.0010\",\n  \"cost_report\": \"estimated cost: $0.0010 (resources=4, minutes_alive=5, requests=4, cap=$0.05)\",\n  \"resource_count\": 4,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"dns_zone_lmgcp_mesh_internal_1\",\n      \"kind\": \"dns_zone\",\n      \"google_type\": \"google_dns_managed_zone\",\n      \"subtype\": \"private\",\n      \"name\": \"lmgcp-mesh-internal\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0007\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"dns_record_lmgcp_mesh_internal_checkout_mesh_lmgcp_internal_2\",\n      \"kind\": \"dns_record\",\n      \"google_type\": \"google_dns_record_set\",\n      \"subtype\": \"A\",\n      \"name\": \"lmgcp-mesh-internal/checkout.mesh.lmgcp.internal.\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"dns_record_lmgcp_mesh_internal_payments_mesh_lmgcp_internal_3\",\n      \"kind\": \"dns_record\",\n      \"google_type\": \"google_dns_record_set\",\n      \"subtype\": \"A\",\n      \"name\": \"lmgcp-mesh-internal/payments.mesh.lmgcp.internal.\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 4,\n      \"ident\": \"dns_record_lmgcp_mesh_internal__policy_mesh_lmgcp_internal_4\",\n      \"kind\": \"dns_record\",\n      \"google_type\": \"google_dns_record_set\",\n      \"subtype\": \"TXT\",\n      \"name\": \"lmgcp-mesh-internal/_Policy.mesh.lmgcp.internal.\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/36_dns_split_horizon_microservice_mesh/36_dns_split_horizon_microservice_mesh.dslb");
r = system ${dsl_cli(p)} --dsl build/compare/36_dns_split_horizon_microservice_mesh/36_dns_split_horizon_microservice_mesh.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/36_dns_split_horizon_microservice_mesh/status.txt")) == "OK");
println("ok compare/36_dns_split_horizon_microservice_mesh - tofu init/plan/apply/destroy verified (resources=4, leftovers=0)");
println("estimated cost: $0.0010 (resources=4, minutes_alive=5, requests=4, cap=$0.05)");
