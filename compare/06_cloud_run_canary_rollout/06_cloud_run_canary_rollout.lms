# OpenTofu (lmcloud) equivalent for lmgcp example: 06_cloud_run_canary_rollout
# Validates and formats compare/06_cloud_run_canary_rollout/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/06_cloud_run_canary_rollout/workdir");
write_file("build/compare/06_cloud_run_canary_rollout/workdir/main.tf", "resource \"terraform_data\" \"cloud_run_lmgcp_checkout_api_1\" {\n  input = \"google_cloud_run_v2_service:lmgcp-checkout-api:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"06_cloud_run_canary_rollout\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0004\"\n}\n\noutput \"resource_count\" {\n  value = \"1\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/06_cloud_run_canary_rollout/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/06_cloud_run_canary_rollout/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/06_cloud_run_canary_rollout");

  let dir = "build/compare/06_cloud_run_canary_rollout/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 1 && out_ex == "06_cloud_run_canary_rollout" && out_cost == "$0.0004" && out_cnt == "1" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/06_cloud_run_canary_rollout/status.txt", status);
  file_write("build/compare/06_cloud_run_canary_rollout/lmcloud-evidence.json", "{\n  \"example\": \"06_cloud_run_canary_rollout\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.0004,\n  \"estimated_cost_formatted\": \"$0.0004\",\n  \"cost_report\": \"estimated cost: $0.0004 (resources=1, minutes_alive=2, requests=1, cap=$0.05)\",\n  \"resource_count\": 1,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"cloud_run_lmgcp_checkout_api_1\",\n      \"kind\": \"cloud_run\",\n      \"google_type\": \"google_cloud_run_v2_service\",\n      \"subtype\": \"us-central1\",\n      \"name\": \"lmgcp-checkout-api\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0004\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/06_cloud_run_canary_rollout/06_cloud_run_canary_rollout.dslb");
r = system ${dsl_cli(p)} --dsl build/compare/06_cloud_run_canary_rollout/06_cloud_run_canary_rollout.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/06_cloud_run_canary_rollout/status.txt")) == "OK");
println("ok compare/06_cloud_run_canary_rollout - tofu init/plan/apply/destroy verified (resources=1, leftovers=0)");
println("estimated cost: $0.0004 (resources=1, minutes_alive=2, requests=1, cap=$0.05)");
