# OpenTofu (lmcloud) equivalent for lmgcp example: 37_logging_monitoring_incident_pipeline
# Validates and formats compare/37_logging_monitoring_incident_pipeline/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/37_logging_monitoring_incident_pipeline/workdir");
write_file("build/compare/37_logging_monitoring_incident_pipeline/workdir/main.tf", "resource \"terraform_data\" \"log_entry_lmgcp_incident_log_1\" {\n  input = \"terraform_data:lmgcp-incident-log:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"log_entry_lmgcp_incident_log_2\" {\n  input = \"terraform_data:lmgcp-incident-log:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"log_entry_lmgcp_incident_log_3\" {\n  input = \"terraform_data:lmgcp-incident-log:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"log_sink_lmgcp_incident_sink_4\" {\n  input = \"google_logging_project_sink:lmgcp-incident-sink:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"alert_policy_lmgcp_incident_slo_alert_5\" {\n  input = \"google_monitoring_alert_policy:lmgcp-incident-slo-alert:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"37_logging_monitoring_incident_pipeline\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0006\"\n}\n\noutput \"resource_count\" {\n  value = \"5\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/37_logging_monitoring_incident_pipeline/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/37_logging_monitoring_incident_pipeline/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/37_logging_monitoring_incident_pipeline");

  let dir = "build/compare/37_logging_monitoring_incident_pipeline/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 5 && out_ex == "37_logging_monitoring_incident_pipeline" && out_cost == "$0.0006" && out_cnt == "5" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/37_logging_monitoring_incident_pipeline/status.txt", status);
  file_write("build/compare/37_logging_monitoring_incident_pipeline/lmcloud-evidence.json", "{\n  \"example\": \"37_logging_monitoring_incident_pipeline\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.0006,\n  \"estimated_cost_formatted\": \"$0.0006\",\n  \"cost_report\": \"estimated cost: $0.0006 (resources=5, minutes_alive=2, requests=5, cap=$0.05)\",\n  \"resource_count\": 5,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"log_entry_lmgcp_incident_log_1\",\n      \"kind\": \"log_entry\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"INFO\",\n      \"name\": \"lmgcp-incident-log\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"log_entry_lmgcp_incident_log_2\",\n      \"kind\": \"log_entry\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"WARNING\",\n      \"name\": \"lmgcp-incident-log\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"log_entry_lmgcp_incident_log_3\",\n      \"kind\": \"log_entry\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"ERROR\",\n      \"name\": \"lmgcp-incident-log\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 4,\n      \"ident\": \"log_sink_lmgcp_incident_sink_4\",\n      \"kind\": \"log_sink\",\n      \"google_type\": \"google_logging_project_sink\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-incident-sink\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 5,\n      \"ident\": \"alert_policy_lmgcp_incident_slo_alert_5\",\n      \"kind\": \"alert_policy\",\n      \"google_type\": \"google_monitoring_alert_policy\",\n      \"subtype\": \"run.googleapis.com/request_latencies_p95_ms\",\n      \"name\": \"lmgcp-incident-slo-alert\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0002\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/37_logging_monitoring_incident_pipeline/37_logging_monitoring_incident_pipeline.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/37_logging_monitoring_incident_pipeline/37_logging_monitoring_incident_pipeline.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/37_logging_monitoring_incident_pipeline/status.txt")) == "OK");
println("ok compare/37_logging_monitoring_incident_pipeline - tofu init/plan/apply/destroy verified (resources=5, leftovers=0)");
println("estimated cost: $0.0006 (resources=5, minutes_alive=2, requests=5, cap=$0.05)");
