# OpenTofu (lmcloud) equivalent for lmgcp example: 21_vpc_subnet_cidr_utilization
# Validates and formats compare/21_vpc_subnet_cidr_utilization/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/21_vpc_subnet_cidr_utilization/workdir");
write_file("build/compare/21_vpc_subnet_cidr_utilization/workdir/main.tf", "resource \"terraform_data\" \"vpc_lmgcp_vpc_sandbox_1\" {\n  input = \"google_compute_network:lmgcp-vpc-sandbox:lmgcp_test=vpc-subnet-21\"\n}\n\nresource \"terraform_data\" \"subnet_lmgcp_subnet_sandbox_2\" {\n  input = \"google_compute_subnetwork:lmgcp-subnet-sandbox:lmgcp_test=vpc-subnet-21\"\n}\n\noutput \"example_id\" {\n  value = \"21_vpc_subnet_cidr_utilization\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0003\"\n}\n\noutput \"resource_count\" {\n  value = \"2\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/21_vpc_subnet_cidr_utilization/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/21_vpc_subnet_cidr_utilization/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/21_vpc_subnet_cidr_utilization");

  let dir = "build/compare/21_vpc_subnet_cidr_utilization/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 2 && out_ex == "21_vpc_subnet_cidr_utilization" && out_cost == "$0.0003" && out_cnt == "2" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/21_vpc_subnet_cidr_utilization/status.txt", status);
  file_write("build/compare/21_vpc_subnet_cidr_utilization/lmcloud-evidence.json", "{\n  \"example\": \"21_vpc_subnet_cidr_utilization\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"vpc-subnet-21\",\n  \"estimated_cost_usd\": 0.0003,\n  \"estimated_cost_formatted\": \"$0.0003\",\n  \"cost_report\": \"estimated cost: $0.0003 (resources=2, minutes_alive=2, requests=2, cap=$0.05)\",\n  \"resource_count\": 2,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"vpc_lmgcp_vpc_sandbox_1\",\n      \"kind\": \"vpc\",\n      \"google_type\": \"google_compute_network\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-vpc-sandbox\",\n      \"lmgcp_test\": \"vpc-subnet-21\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"subnet_lmgcp_subnet_sandbox_2\",\n      \"kind\": \"subnet\",\n      \"google_type\": \"google_compute_subnetwork\",\n      \"subtype\": \"us-central1\",\n      \"name\": \"lmgcp-subnet-sandbox\",\n      \"lmgcp_test\": \"vpc-subnet-21\",\n      \"cost_usd\": 0.0002\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/21_vpc_subnet_cidr_utilization/21_vpc_subnet_cidr_utilization.dslb");
r = system ${dsl_cli(p)} --dsl build/compare/21_vpc_subnet_cidr_utilization/21_vpc_subnet_cidr_utilization.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/21_vpc_subnet_cidr_utilization/status.txt")) == "OK");
println("ok compare/21_vpc_subnet_cidr_utilization - tofu init/plan/apply/destroy verified (resources=2, leftovers=0)");
println("estimated cost: $0.0003 (resources=2, minutes_alive=2, requests=2, cap=$0.05)");
