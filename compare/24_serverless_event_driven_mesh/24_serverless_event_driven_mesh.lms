# OpenTofu (lmcloud) equivalent for lmgcp example: 24_serverless_event_driven_mesh
# Validates and formats compare/24_serverless_event_driven_mesh/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/24_serverless_event_driven_mesh/workdir");
write_file("build/compare/24_serverless_event_driven_mesh/workdir/main.tf", "resource \"terraform_data\" \"bucket_lmgcp_mesh_ingest_1\" {\n  input = \"google_storage_bucket:lmgcp-mesh-ingest:lmgcp_test=serverless-mesh-24\"\n}\n\nresource \"terraform_data\" \"storage_object_lmgcp_mesh_ingest_events_batch_01_json_2\" {\n  input = \"google_storage_bucket_object:lmgcp-mesh-ingest/events/batch-01.json:lmgcp_test=serverless-mesh-24\"\n}\n\nresource \"terraform_data\" \"pubsub_topic_lmgcp_mesh_topic_3\" {\n  input = \"google_pubsub_topic:lmgcp-mesh-topic:lmgcp_test=serverless-mesh-24\"\n}\n\nresource \"terraform_data\" \"pubsub_sub_lmgcp_mesh_sub_4\" {\n  input = \"google_pubsub_subscription:lmgcp-mesh-sub:lmgcp_test=serverless-mesh-24\"\n}\n\nresource \"terraform_data\" \"pubsub_msg_lmgcp_mesh_topic_5\" {\n  input = \"terraform_data:lmgcp-mesh-topic:lmgcp_test=serverless-mesh-24\"\n}\n\nresource \"terraform_data\" \"cloud_run_lmgcp_mesh_processor_6\" {\n  input = \"google_cloud_run_v2_service:lmgcp-mesh-processor:lmgcp_test=serverless-mesh-24\"\n}\n\nresource \"terraform_data\" \"bq_dataset_lmgcp_mesh_dw_7\" {\n  input = \"google_bigquery_dataset:lmgcp_mesh_dw:lmgcp_test=serverless-mesh-24\"\n}\n\nresource \"terraform_data\" \"bq_table_lmgcp_mesh_dw_lmgcp_ingested_events_8\" {\n  input = \"google_bigquery_table:lmgcp_mesh_dw/lmgcp_ingested_events:lmgcp_test=serverless-mesh-24\"\n}\n\noutput \"example_id\" {\n  value = \"24_serverless_event_driven_mesh\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0012\"\n}\n\noutput \"resource_count\" {\n  value = \"8\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/24_serverless_event_driven_mesh/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/24_serverless_event_driven_mesh/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/24_serverless_event_driven_mesh");

  let dir = "build/compare/24_serverless_event_driven_mesh/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 8 && out_ex == "24_serverless_event_driven_mesh" && out_cost == "$0.0012" && out_cnt == "8" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/24_serverless_event_driven_mesh/status.txt", status);
  file_write("build/compare/24_serverless_event_driven_mesh/lmcloud-evidence.json", "{\n  \"example\": \"24_serverless_event_driven_mesh\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"serverless-mesh-24\",\n  \"estimated_cost_usd\": 0.0012,\n  \"estimated_cost_formatted\": \"$0.0012\",\n  \"cost_report\": \"estimated cost: $0.0012 (resources=8, minutes_alive=2, requests=8, cap=$0.05)\",\n  \"resource_count\": 8,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"bucket_lmgcp_mesh_ingest_1\",\n      \"kind\": \"bucket\",\n      \"google_type\": \"google_storage_bucket\",\n      \"subtype\": \"STANDARD\",\n      \"name\": \"lmgcp-mesh-ingest\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"storage_object_lmgcp_mesh_ingest_events_batch_01_json_2\",\n      \"kind\": \"storage_object\",\n      \"google_type\": \"google_storage_bucket_object\",\n      \"subtype\": \"application/json\",\n      \"name\": \"lmgcp-mesh-ingest/events/batch-01.json\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"pubsub_topic_lmgcp_mesh_topic_3\",\n      \"kind\": \"pubsub_topic\",\n      \"google_type\": \"google_pubsub_topic\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-mesh-topic\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 4,\n      \"ident\": \"pubsub_sub_lmgcp_mesh_sub_4\",\n      \"kind\": \"pubsub_sub\",\n      \"google_type\": \"google_pubsub_subscription\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-mesh-sub\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 5,\n      \"ident\": \"pubsub_msg_lmgcp_mesh_topic_5\",\n      \"kind\": \"pubsub_msg\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"publish\",\n      \"name\": \"lmgcp-mesh-topic\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 6,\n      \"ident\": \"cloud_run_lmgcp_mesh_processor_6\",\n      \"kind\": \"cloud_run\",\n      \"google_type\": \"google_cloud_run_v2_service\",\n      \"subtype\": \"us-central1\",\n      \"name\": \"lmgcp-mesh-processor\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0004\n    },\n    {\n      \"index\": 7,\n      \"ident\": \"bq_dataset_lmgcp_mesh_dw_7\",\n      \"kind\": \"bq_dataset\",\n      \"google_type\": \"google_bigquery_dataset\",\n      \"subtype\": \"US\",\n      \"name\": \"lmgcp_mesh_dw\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 8,\n      \"ident\": \"bq_table_lmgcp_mesh_dw_lmgcp_ingested_events_8\",\n      \"kind\": \"bq_table\",\n      \"google_type\": \"google_bigquery_table\",\n      \"subtype\": \"ingest_ts\",\n      \"name\": \"lmgcp_mesh_dw/lmgcp_ingested_events\",\n      \"lmgcp_test\": \"serverless-mesh-24\",\n      \"cost_usd\": 0.0002\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/24_serverless_event_driven_mesh/24_serverless_event_driven_mesh.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/24_serverless_event_driven_mesh/24_serverless_event_driven_mesh.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/24_serverless_event_driven_mesh/status.txt")) == "OK");
println("ok compare/24_serverless_event_driven_mesh - tofu init/plan/apply/destroy verified (resources=8, leftovers=0)");
println("estimated cost: $0.0012 (resources=8, minutes_alive=2, requests=8, cap=$0.05)");
