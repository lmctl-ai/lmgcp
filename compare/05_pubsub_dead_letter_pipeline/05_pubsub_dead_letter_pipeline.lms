# OpenTofu (lmcloud) equivalent for lmgcp example: 05_pubsub_dead_letter_pipeline
# Validates and formats compare/05_pubsub_dead_letter_pipeline/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/05_pubsub_dead_letter_pipeline/workdir");
write_file("build/compare/05_pubsub_dead_letter_pipeline/workdir/main.tf", "resource \"terraform_data\" \"pubsub_topic_lmgcp_orders_dlq_1\" {\n  input = \"google_pubsub_topic:lmgcp-orders-dlq:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"pubsub_topic_lmgcp_orders_stream_2\" {\n  input = \"google_pubsub_topic:lmgcp-orders-stream:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"pubsub_sub_lmgcp_orders_worker_sub_3\" {\n  input = \"google_pubsub_subscription:lmgcp-orders-worker-sub:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"pubsub_msg_lmgcp_orders_stream_4\" {\n  input = \"terraform_data:lmgcp-orders-stream:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"pubsub_msg_lmgcp_orders_stream_5\" {\n  input = \"terraform_data:lmgcp-orders-stream:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"pubsub_msg_lmgcp_orders_stream_6\" {\n  input = \"terraform_data:lmgcp-orders-stream:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"05_pubsub_dead_letter_pipeline\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0006\"\n}\n\noutput \"resource_count\" {\n  value = \"6\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/05_pubsub_dead_letter_pipeline/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/05_pubsub_dead_letter_pipeline/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/05_pubsub_dead_letter_pipeline");

  let dir = "build/compare/05_pubsub_dead_letter_pipeline/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 6 && out_ex == "05_pubsub_dead_letter_pipeline" && out_cost == "$0.0006" && out_cnt == "6" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/05_pubsub_dead_letter_pipeline/status.txt", status);
  file_write("build/compare/05_pubsub_dead_letter_pipeline/lmcloud-evidence.json", "{\n  \"example\": \"05_pubsub_dead_letter_pipeline\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.0006,\n  \"estimated_cost_formatted\": \"$0.0006\",\n  \"cost_report\": \"estimated cost: $0.0006 (resources=6, minutes_alive=2, requests=6, cap=$0.05)\",\n  \"resource_count\": 6,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"pubsub_topic_lmgcp_orders_dlq_1\",\n      \"kind\": \"pubsub_topic\",\n      \"google_type\": \"google_pubsub_topic\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-orders-dlq\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"pubsub_topic_lmgcp_orders_stream_2\",\n      \"kind\": \"pubsub_topic\",\n      \"google_type\": \"google_pubsub_topic\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-orders-stream\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"pubsub_sub_lmgcp_orders_worker_sub_3\",\n      \"kind\": \"pubsub_sub\",\n      \"google_type\": \"google_pubsub_subscription\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-orders-worker-sub\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 4,\n      \"ident\": \"pubsub_msg_lmgcp_orders_stream_4\",\n      \"kind\": \"pubsub_msg\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"publish\",\n      \"name\": \"lmgcp-orders-stream\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 5,\n      \"ident\": \"pubsub_msg_lmgcp_orders_stream_5\",\n      \"kind\": \"pubsub_msg\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"publish\",\n      \"name\": \"lmgcp-orders-stream\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 6,\n      \"ident\": \"pubsub_msg_lmgcp_orders_stream_6\",\n      \"kind\": \"pubsub_msg\",\n      \"google_type\": \"terraform_data\",\n      \"subtype\": \"publish\",\n      \"name\": \"lmgcp-orders-stream\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/05_pubsub_dead_letter_pipeline/05_pubsub_dead_letter_pipeline.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/05_pubsub_dead_letter_pipeline/05_pubsub_dead_letter_pipeline.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/05_pubsub_dead_letter_pipeline/status.txt")) == "OK");
println("ok compare/05_pubsub_dead_letter_pipeline - tofu init/plan/apply/destroy verified (resources=6, leftovers=0)");
println("estimated cost: $0.0006 (resources=6, minutes_alive=2, requests=6, cap=$0.05)");
