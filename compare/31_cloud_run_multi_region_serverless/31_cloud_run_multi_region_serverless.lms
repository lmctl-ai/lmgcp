# OpenTofu (lmcloud) equivalent for lmgcp example: 31_cloud_run_multi_region_serverless
# Validates and formats compare/31_cloud_run_multi_region_serverless/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/31_cloud_run_multi_region_serverless/workdir");
write_file("build/compare/31_cloud_run_multi_region_serverless/workdir/main.tf", "resource \"terraform_data\" \"cloud_run_lmgcp_edge_webhook_usc1_1\" {\n  input = \"google_cloud_run_v2_service:lmgcp-edge-webhook-usc1:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"cloud_run_lmgcp_edge_webhook_use1_2\" {\n  input = \"google_cloud_run_v2_service:lmgcp-edge-webhook-use1:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"31_cloud_run_multi_region_serverless\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0008\"\n}\n\noutput \"resource_count\" {\n  value = \"2\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/31_cloud_run_multi_region_serverless/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/31_cloud_run_multi_region_serverless/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/31_cloud_run_multi_region_serverless");

  let dir = "build/compare/31_cloud_run_multi_region_serverless/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 2 && out_ex == "31_cloud_run_multi_region_serverless" && out_cost == "$0.0008" && out_cnt == "2" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/31_cloud_run_multi_region_serverless/status.txt", status);
  file_write("build/compare/31_cloud_run_multi_region_serverless/lmcloud-evidence.json", "{\n  \"example\": \"31_cloud_run_multi_region_serverless\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.0008,\n  \"estimated_cost_formatted\": \"$0.0008\",\n  \"cost_report\": \"estimated cost: $0.0008 (resources=2, minutes_alive=2, requests=2, cap=$0.05)\",\n  \"resource_count\": 2,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"cloud_run_lmgcp_edge_webhook_usc1_1\",\n      \"kind\": \"cloud_run\",\n      \"google_type\": \"google_cloud_run_v2_service\",\n      \"subtype\": \"us-central1\",\n      \"name\": \"lmgcp-edge-webhook-usc1\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0004\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"cloud_run_lmgcp_edge_webhook_use1_2\",\n      \"kind\": \"cloud_run\",\n      \"google_type\": \"google_cloud_run_v2_service\",\n      \"subtype\": \"us-east1\",\n      \"name\": \"lmgcp-edge-webhook-use1\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0004\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/31_cloud_run_multi_region_serverless/31_cloud_run_multi_region_serverless.dslb");
r = system ${dsl_cli(p)} --lmcode build/compare/31_cloud_run_multi_region_serverless/31_cloud_run_multi_region_serverless.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/31_cloud_run_multi_region_serverless/status.txt")) == "OK");
println("ok compare/31_cloud_run_multi_region_serverless - tofu init/plan/apply/destroy verified (resources=2, leftovers=0)");
println("estimated cost: $0.0008 (resources=2, minutes_alive=2, requests=2, cap=$0.05)");
