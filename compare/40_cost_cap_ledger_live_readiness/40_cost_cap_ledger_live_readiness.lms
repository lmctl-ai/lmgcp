# OpenTofu (lmcloud) equivalent for lmgcp example: 40_cost_cap_ledger_live_readiness
# Validates and formats compare/40_cost_cap_ledger_live_readiness/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/40_cost_cap_ledger_live_readiness/workdir");
write_file("build/compare/40_cost_cap_ledger_live_readiness/workdir/main.tf", "resource \"terraform_data\" \"vpc_lmgcp_probe_vpc_1\" {\n  input = \"google_compute_network:lmgcp-probe-vpc:lmgcp_test=cost-readiness-40\"\n}\n\nresource \"terraform_data\" \"subnet_lmgcp_probe_sub_2\" {\n  input = \"google_compute_subnetwork:lmgcp-probe-sub:lmgcp_test=cost-readiness-40\"\n}\n\nresource \"terraform_data\" \"bucket_lmgcp_probe_bkt_3\" {\n  input = \"google_storage_bucket:lmgcp-probe-bkt:lmgcp_test=cost-readiness-40\"\n}\n\nresource \"terraform_data\" \"pubsub_topic_lmgcp_probe_topic_4\" {\n  input = \"google_pubsub_topic:lmgcp-probe-topic:lmgcp_test=cost-readiness-40\"\n}\n\nresource \"terraform_data\" \"cloud_run_lmgcp_probe_run_5\" {\n  input = \"google_cloud_run_v2_service:lmgcp-probe-run:lmgcp_test=cost-readiness-40\"\n}\n\nresource \"terraform_data\" \"compute_instance_lmgcp_probe_vm_6\" {\n  input = \"google_compute_instance:lmgcp-probe-vm:lmgcp_test=cost-readiness-40\"\n}\n\noutput \"example_id\" {\n  value = \"40_cost_cap_ledger_live_readiness\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0018\"\n}\n\noutput \"resource_count\" {\n  value = \"6\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/40_cost_cap_ledger_live_readiness/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/40_cost_cap_ledger_live_readiness/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/40_cost_cap_ledger_live_readiness");

  let dir = "build/compare/40_cost_cap_ledger_live_readiness/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 6 && out_ex == "40_cost_cap_ledger_live_readiness" && out_cost == "$0.0018" && out_cnt == "6" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/40_cost_cap_ledger_live_readiness/status.txt", status);
  file_write("build/compare/40_cost_cap_ledger_live_readiness/lmcloud-evidence.json", "{\n  \"example\": \"40_cost_cap_ledger_live_readiness\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"cost-readiness-40\",\n  \"estimated_cost_usd\": 0.0018,\n  \"estimated_cost_formatted\": \"$0.0018\",\n  \"cost_report\": \"estimated cost: $0.0018 (resources=6, minutes_alive=5, requests=6, cap=$0.0050)\",\n  \"resource_count\": 6,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"vpc_lmgcp_probe_vpc_1\",\n      \"kind\": \"vpc\",\n      \"google_type\": \"google_compute_network\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-probe-vpc\",\n      \"lmgcp_test\": \"cost-readiness-40\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"subnet_lmgcp_probe_sub_2\",\n      \"kind\": \"subnet\",\n      \"google_type\": \"google_compute_subnetwork\",\n      \"subtype\": \"us-central1\",\n      \"name\": \"lmgcp-probe-sub\",\n      \"lmgcp_test\": \"cost-readiness-40\",\n      \"cost_usd\": 0.0002\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"bucket_lmgcp_probe_bkt_3\",\n      \"kind\": \"bucket\",\n      \"google_type\": \"google_storage_bucket\",\n      \"subtype\": \"STANDARD\",\n      \"name\": \"lmgcp-probe-bkt\",\n      \"lmgcp_test\": \"cost-readiness-40\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 4,\n      \"ident\": \"pubsub_topic_lmgcp_probe_topic_4\",\n      \"kind\": \"pubsub_topic\",\n      \"google_type\": \"google_pubsub_topic\",\n      \"subtype\": \"global\",\n      \"name\": \"lmgcp-probe-topic\",\n      \"lmgcp_test\": \"cost-readiness-40\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 5,\n      \"ident\": \"cloud_run_lmgcp_probe_run_5\",\n      \"kind\": \"cloud_run\",\n      \"google_type\": \"google_cloud_run_v2_service\",\n      \"subtype\": \"us-central1\",\n      \"name\": \"lmgcp-probe-run\",\n      \"lmgcp_test\": \"cost-readiness-40\",\n      \"cost_usd\": 0.0004\n    },\n    {\n      \"index\": 6,\n      \"ident\": \"compute_instance_lmgcp_probe_vm_6\",\n      \"kind\": \"compute_instance\",\n      \"google_type\": \"google_compute_instance\",\n      \"subtype\": \"e2-micro\",\n      \"name\": \"lmgcp-probe-vm\",\n      \"lmgcp_test\": \"cost-readiness-40\",\n      \"cost_usd\": 0.0009\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/40_cost_cap_ledger_live_readiness/40_cost_cap_ledger_live_readiness.dslb");
r = system ${dsl_cli(p)} --dsl build/compare/40_cost_cap_ledger_live_readiness/40_cost_cap_ledger_live_readiness.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/40_cost_cap_ledger_live_readiness/status.txt")) == "OK");
println("ok compare/40_cost_cap_ledger_live_readiness - tofu init/plan/apply/destroy verified (resources=6, leftovers=0)");
println("estimated cost: $0.0018 (resources=6, minutes_alive=5, requests=6, cap=$0.0050)");
