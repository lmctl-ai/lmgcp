# OpenTofu (lmcloud) equivalent for lmgcp example: 34_firestore_multi_collection_state_store
# Validates and formats compare/34_firestore_multi_collection_state_store/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/34_firestore_multi_collection_state_store/workdir");
write_file("build/compare/34_firestore_multi_collection_state_store/workdir/main.tf", "resource \"terraform_data\" \"firestore_doc_wf_101_1\" {\n  input = \"google_firestore_document:wf-101:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"firestore_doc_wf_102_2\" {\n  input = \"google_firestore_document:wf-102:lmgcp_test=run-20261024\"\n}\n\nresource \"terraform_data\" \"firestore_doc_lock_shard_0_3\" {\n  input = \"google_firestore_document:lock-shard-0:lmgcp_test=run-20261024\"\n}\n\noutput \"example_id\" {\n  value = \"34_firestore_multi_collection_state_store\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0003\"\n}\n\noutput \"resource_count\" {\n  value = \"3\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/34_firestore_multi_collection_state_store/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/34_firestore_multi_collection_state_store/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/34_firestore_multi_collection_state_store");

  let dir = "build/compare/34_firestore_multi_collection_state_store/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 3 && out_ex == "34_firestore_multi_collection_state_store" && out_cost == "$0.0003" && out_cnt == "3" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/34_firestore_multi_collection_state_store/status.txt", status);
  file_write("build/compare/34_firestore_multi_collection_state_store/lmcloud-evidence.json", "{\n  \"example\": \"34_firestore_multi_collection_state_store\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0.0003,\n  \"estimated_cost_formatted\": \"$0.0003\",\n  \"cost_report\": \"estimated cost: $0.0003 (resources=3, minutes_alive=1, requests=3, cap=$0.05)\",\n  \"resource_count\": 3,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"firestore_doc_wf_101_1\",\n      \"kind\": \"firestore_doc\",\n      \"google_type\": \"google_firestore_document\",\n      \"subtype\": \"lmgcp_workflows\",\n      \"name\": \"wf-101\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 2,\n      \"ident\": \"firestore_doc_wf_102_2\",\n      \"kind\": \"firestore_doc\",\n      \"google_type\": \"google_firestore_document\",\n      \"subtype\": \"lmgcp_workflows\",\n      \"name\": \"wf-102\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    },\n    {\n      \"index\": 3,\n      \"ident\": \"firestore_doc_lock_shard_0_3\",\n      \"kind\": \"firestore_doc\",\n      \"google_type\": \"google_firestore_document\",\n      \"subtype\": \"lmgcp_locks\",\n      \"name\": \"lock-shard-0\",\n      \"lmgcp_test\": \"run-20261024\",\n      \"cost_usd\": 0.0001\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/34_firestore_multi_collection_state_store/34_firestore_multi_collection_state_store.dslb");
r = system ${dsl_cli(p)} --dsl build/compare/34_firestore_multi_collection_state_store/34_firestore_multi_collection_state_store.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/34_firestore_multi_collection_state_store/status.txt")) == "OK");
println("ok compare/34_firestore_multi_collection_state_store - tofu init/plan/apply/destroy verified (resources=3, leftovers=0)");
println("estimated cost: $0.0003 (resources=3, minutes_alive=1, requests=3, cap=$0.05)");
