# OpenTofu (lmcloud) equivalent for lmgcp example: 08_vpc_resource_topology_graph
# Validates and formats compare/08_vpc_resource_topology_graph/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/08_vpc_resource_topology_graph/workdir");
write_file("build/compare/08_vpc_resource_topology_graph/workdir/main.tf", "resource \"terraform_data\" \"readonly_audit_01\" {\n  input = \"08_vpc_resource_topology_graph:readonly:0\"\n}\n\noutput \"example_id\" {\n  value = \"08_vpc_resource_topology_graph\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.00\"\n}\n\noutput \"resource_count\" {\n  value = \"0\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/08_vpc_resource_topology_graph/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/08_vpc_resource_topology_graph/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/08_vpc_resource_topology_graph");

  let dir = "build/compare/08_vpc_resource_topology_graph/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 1 && out_ex == "08_vpc_resource_topology_graph" && out_cost == "$0.00" && out_cnt == "0" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/08_vpc_resource_topology_graph/status.txt", status);
  file_write("build/compare/08_vpc_resource_topology_graph/lmcloud-evidence.json", "{\n  \"example\": \"08_vpc_resource_topology_graph\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"run-20261024\",\n  \"estimated_cost_usd\": 0,\n  \"estimated_cost_formatted\": \"$0.00\",\n  \"cost_report\": \"estimated cost: $0.00 (read-only; resources=0, minutes_alive=0, requests=0)\",\n  \"resource_count\": 0,\n  \"leftover_count\": 0,\n  \"resources\": []\n}");
end _dsl_
savedsl(p, "build/compare/08_vpc_resource_topology_graph/08_vpc_resource_topology_graph.dslb");
r = system ${dsl_cli(p)} --dsl build/compare/08_vpc_resource_topology_graph/08_vpc_resource_topology_graph.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/08_vpc_resource_topology_graph/status.txt")) == "OK");
println("ok compare/08_vpc_resource_topology_graph - tofu init/plan/apply/destroy verified (resources=0, leftovers=0)");
println("estimated cost: $0.00 (read-only; resources=0, minutes_alive=0, requests=0)");
