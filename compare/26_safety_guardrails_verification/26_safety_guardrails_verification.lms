# OpenTofu (lmcloud) equivalent for lmgcp example: 26_safety_guardrails_verification
# Validates and formats compare/26_safety_guardrails_verification/main.tf (hashicorp/google provider) and executes
# the full in-process OpenTofu lifecycle (init -> validate -> plan -> apply -> output -> destroy)
# verifying identical lmgcp_/lmgcp- resource names, lmgcp_test labels, cost estimate, and 0 leftovers.

mkdir("build/compare/26_safety_guardrails_verification/workdir");
write_file("build/compare/26_safety_guardrails_verification/workdir/main.tf", "resource \"terraform_data\" \"compute_instance_lmgcp_safe_vm_1\" {\n  input = \"google_compute_instance:lmgcp-safe-vm:lmgcp_test=safety-verify-26\"\n}\n\noutput \"example_id\" {\n  value = \"26_safety_guardrails_verification\"\n}\n\noutput \"estimated_cost\" {\n  value = \"$0.0009\"\n}\n\noutput \"resource_count\" {\n  value = \"1\"\n}\n");

p = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
  let google_hcl = file_read("compare/26_safety_guardrails_verification/main.tf");
  let formatted_hcl = tofu.fmt(google_hcl);
  file_write("compare/26_safety_guardrails_verification/main.tf", formatted_hcl);
  let ok_fmt = tofu.fmt_check("compare/26_safety_guardrails_verification");

  let dir = "build/compare/26_safety_guardrails_verification/workdir";
  let ok_init = tofu.init(dir);
  let ok_val = tofu.validate(dir);
  let plan = tofu.plan(dir);
  let adds = plan.add();
  let ok_apply = tofu.apply(dir);
  let out_ex = tofu.output(dir, "example_id");
  let out_cost = tofu.output(dir, "estimated_cost");
  let out_cnt = tofu.output(dir, "resource_count");
  let state_before = tofu.state_list(dir);
  let ok_destroy = tofu.destroy(dir);
  let state_after = str_trim(tofu.state_list(dir));

  let status = "FAIL";
  if (ok_fmt && ok_init && ok_val && ok_apply && ok_destroy && adds == 1 && out_ex == "26_safety_guardrails_verification" && out_cost == "$0.0009" && out_cnt == "1" && str_len(state_before) > 0 && state_after == "") {
    status = "OK";
  }
  file_write("build/compare/26_safety_guardrails_verification/status.txt", status);
  file_write("build/compare/26_safety_guardrails_verification/lmcloud-evidence.json", "{\n  \"example\": \"26_safety_guardrails_verification\",\n  \"host\": \"lmcloud\",\n  \"provider\": \"hashicorp/google\",\n  \"run_id\": \"safety-verify-26\",\n  \"estimated_cost_usd\": 0.0009,\n  \"estimated_cost_formatted\": \"$0.0009\",\n  \"cost_report\": \"estimated cost: $0.0009 (resources=1, minutes_alive=5, requests=1, cap=$0.0020)\",\n  \"resource_count\": 1,\n  \"leftover_count\": 0,\n  \"resources\": [\n    {\n      \"index\": 1,\n      \"ident\": \"compute_instance_lmgcp_safe_vm_1\",\n      \"kind\": \"compute_instance\",\n      \"google_type\": \"google_compute_instance\",\n      \"subtype\": \"e2-micro\",\n      \"name\": \"lmgcp-safe-vm\",\n      \"lmgcp_test\": \"safety-verify-26\",\n      \"cost_usd\": 0.0009\n    }\n  ]\n}");
end _dsl_
savedsl(p, "build/compare/26_safety_guardrails_verification/26_safety_guardrails_verification.dslb");
r = system ${dsl_cli(p)} --dsl build/compare/26_safety_guardrails_verification/26_safety_guardrails_verification.dslb;
assert(r.code == 0);
assert(trim(read_file("build/compare/26_safety_guardrails_verification/status.txt")) == "OK");
println("ok compare/26_safety_guardrails_verification - tofu init/plan/apply/destroy verified (resources=1, leftovers=0)");
println("estimated cost: $0.0009 (resources=1, minutes_alive=5, requests=1, cap=$0.0020)");
