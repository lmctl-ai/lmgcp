# GKE Kubernetes cluster security hardening matrix: compares 3 clusters across Autopilot mode,
# Private Nodes, Workload Identity, Network Policy, Binary Authorization, and Release Channels.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  let clusters = gcp.gke_list_clusters("-");
  assert_close(float(clusters.len()), 3.0, 0.01);

  let c1 = gcp.gke_get_cluster("us-central1", "prod-autopilot-core");
  let c2 = gcp.gke_get_cluster("us-east1", "dr-autopilot-standby");
  let c3 = gcp.gke_get_cluster("us-central1", "staging-standard-k8s");

  check(c1.autopilot());
  check(c1.private_nodes());
  check(c1.workload_identity());
  check(c1.network_policy());
  check(c1.binary_auth());
  assert_close(float(c1.total_nodes()), 18.0, 0.01);

  check(c2.autopilot());
  assert_close(float(c2.total_nodes()), 8.0, 0.01);

  check(!c3.autopilot());
  check(!c3.private_nodes());
  check(!c3.binary_auth());
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("12_gke_cluster_hardening_matrix", "build/evidence/live-cost-12_gke_cluster_hardening_matrix.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 12_gke_cluster_hardening_matrix (lmgcp; lmdraw step awaits host migration)");
