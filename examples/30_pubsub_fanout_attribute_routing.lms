# Builds a multi-subscriber Pub/Sub fan-out pipeline (lmgcp-orders-stream -> billing + warehouse
# subscriptions + DLQ), publishes 4 attributed messages, pulls from both subscribers, and cleans up.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  let top = gcp.pubsub_create_topic("lmgcp-orders-stream");
  let dlq = gcp.pubsub_create_topic("lmgcp-orders-dlq");
  let sub_bill = gcp.pubsub_create_subscription("lmgcp-orders-billing-sub", "lmgcp-orders-stream", 30, "lmgcp-orders-dlq");
  let sub_wh = gcp.pubsub_create_subscription("lmgcp-orders-warehouse-sub", "lmgcp-orders-stream", 60, "lmgcp-orders-dlq");

  let attrs = str_map();
  attrs.set("region", "us-central1");
  attrs.set("schema", "orders.v2");

  gcp.pubsub_publish("lmgcp-orders-stream", "order_id=9001,amount=49.99", attrs);
  gcp.pubsub_publish("lmgcp-orders-stream", "order_id=9002,amount=129.00", attrs);
  gcp.pubsub_publish("lmgcp-orders-stream", "order_id=9003,amount=19.50", attrs);
  gcp.pubsub_publish("lmgcp-orders-stream", "order_id=9004,amount=299.00", attrs);

  let t_info = gcp.pubsub_get_topic("lmgcp-orders-stream");
  assert_close(float(t_info.published_count()), 4.0, 0.01);

  let m_bill = gcp.pubsub_pull("lmgcp-orders-billing-sub", 10);
  let m_wh = gcp.pubsub_pull("lmgcp-orders-warehouse-sub", 10);
  assert_close(float(m_bill.len()), 4.0, 0.01);
  assert_close(float(m_wh.len()), 4.0, 0.01);

  let del = gcp.cleanup_ledger();
  assert_close(float(del), 4.0, 0.01);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);

  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("30_pubsub_fanout_attribute_routing", "build/evidence/live-cost-30_pubsub_fanout_attribute_routing.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 30_pubsub_fanout_attribute_routing (lmgcp; lmdraw step awaits host migration)");
