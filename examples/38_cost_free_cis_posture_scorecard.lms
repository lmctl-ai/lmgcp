# Cost-free read-only CIS Google Cloud Foundations Benchmark scorecard across 7 service
# families (Compute, VPC, GCS, Cloud SQL, GKE, KMS, IAM) with $0.00 cloud spend.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  let vms = gcp.compute_list_instances("all");
  let bkts = gcp.storage_list_buckets();
  let sqls = gcp.sql_list_instances();
  let gkes = gcp.gke_list_clusters("-");
  assert_close(float(vms.len()), 7.0, 0.01);
  assert_close(float(bkts.len()), 5.0, 0.01);
  assert_close(float(sqls.len()), 3.0, 0.01);
  assert_close(float(gkes.len()), 3.0, 0.01);

  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("38_cost_free_cis_posture_scorecard", "build/evidence/live-cost-38_cost_free_cis_posture_scorecard.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 38_cost_free_cis_posture_scorecard (lmgcp; lmdraw step awaits host migration)");
