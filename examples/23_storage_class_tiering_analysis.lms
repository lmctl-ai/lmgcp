# Cloud Storage bucket classes (STANDARD, NEARLINE, COLDLINE, ARCHIVE), CMEK encryption,
# Uniform Bucket-Level Access, and Public Access Prevention posture across 5 buckets.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  let bkts = gcp.storage_list_buckets();
  assert_close(float(bkts.len()), 5.0, 0.01);

  let b1 = gcp.storage_get_bucket("prod-customer-invoices-us");
  let b2 = gcp.storage_get_bucket("prod-telemetry-parquet-us");
  let b3 = gcp.storage_get_bucket("prod-compliance-ledger-archive");
  let b4 = gcp.storage_get_bucket("coldline-db-snapshots-us");
  let b5 = gcp.storage_get_bucket("staging-build-artifacts-c1");

  check(b1.storage_class() == "STANDARD");
  check(b1.encryption_type() == "CMEK");
  check(b2.storage_class() == "NEARLINE");
  check(b3.storage_class() == "ARCHIVE");
  check(b3.encryption_type() == "CMEK");
  check(b4.storage_class() == "COLDLINE");
  check(!b5.uniform_access());
  assert_close(float(b5.lifecycle_delete_days()), 0.0, 0.01);
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("23_storage_class_tiering_analysis", "build/evidence/live-cost-23_storage_class_tiering_analysis.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 23_storage_class_tiering_analysis (lmgcp; lmdraw step awaits host migration)");
