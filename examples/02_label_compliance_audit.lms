# FinOps & governance mandatory label compliance audit (env, owner, cost_center, data_class)
# across Compute Engine, Cloud Storage, Cloud Run, Cloud SQL, GKE, and Secret Manager.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  let req = str_list().add("env").add("owner").add("cost_center").add("data_class");
  let rep = gcp.audit_label_compliance(req);

  let comp_pct = str_to_int(rep.get("compute_pct"));
  let bkt_pct = str_to_int(rep.get("storage_pct"));
  let run_pct = str_to_int(rep.get("cloud_run_pct"));
  let sql_pct = str_to_int(rep.get("sql_pct"));
  let gke_pct = str_to_int(rep.get("gke_pct"));
  let sec_pct = str_to_int(rep.get("secrets_pct"));
  let all_pct = str_to_int(rep.get("overall_pct"));

  assert_close(float(comp_pct), 71.0, 1.0);
  assert_close(float(bkt_pct), 80.0, 1.0);
  assert_close(float(run_pct), 100.0, 1.0);
  assert_close(float(sql_pct), 66.0, 1.0);
  assert_close(float(gke_pct), 66.0, 1.0);
  assert_close(float(sec_pct), 80.0, 1.0);
  assert_close(float(all_pct), 76.0, 1.0);
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("02_label_compliance_audit", "build/evidence/live-cost-02_label_compliance_audit.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 02_label_compliance_audit (lmgcp; lmdraw step awaits host migration)");
