# Audits Cloud KMS keyrings and CryptoKeys in us-central1 and creates two ephemeral HSM
# CryptoKeys (lmgcp-envelope-dek-01 and lmgcp-artifact-sign-01) with 30d and 60d rotation.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  let rings = gcp.kms_list_keyrings("us-central1");
  assert_close(float(rings.len()), 1.0, 0.01);

  let k1 = gcp.kms_create_key("us-central1", "prod-ring", "lmgcp-envelope-dek-01", "ENCRYPT_DECRYPT", 30);
  let k2 = gcp.kms_create_key("us-central1", "prod-ring", "lmgcp-artifact-sign-01", "ENCRYPT_DECRYPT", 60);
  assert_close(float(k1.rotation_days()), 30.0, 0.01);
  assert_close(float(k2.rotation_days()), 60.0, 0.01);

  let keys = gcp.kms_list_keys("us-central1", "prod-ring");
  assert_close(float(keys.len()), 5.0, 0.01);

  gcp.cleanup_ledger();
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);

  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("35_kms_multi_keyring_envelope_audit", "build/evidence/live-cost-35_kms_multi_keyring_envelope_audit.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 35_kms_multi_keyring_envelope_audit (lmgcp; lmdraw step awaits host migration)");
