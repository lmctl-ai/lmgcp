# Cost-free read-only audit of project IAM policy bindings (iam_list_bindings) and service
# account privilege tiers (roles/editor vs scoped roles) without modifying IAM state ($0.00).
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

p = _dsl_ cli="lmgcp" install="github:lmctl-ai/lmgcp@latest";
  let bindings = gcp.iam_list_bindings();
  let sas = gcp.iam_list_service_accounts();
  assert_close(float(bindings.len()), 7.0, 0.01);
  assert_close(float(sas.len()), 5.0, 0.01);

  let editor_count = 0;
  let i = 0;
  while (i < bindings.len()) {
    if (str_contains(bindings.at(i), "roles/editor")) {
      editor_count = editor_count + 1;
    }
    i = i + 1;
  }
  assert_close(float(editor_count), 2.0, 0.01);
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("32_iam_binding_blast_radius_audit", "build/evidence/live-cost-32_iam_binding_blast_radius_audit.json");
  print(gcp.cost_report());
end _dsl_
savedsl(p, "build/examples/32_iam_binding_blast_radius_audit.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/32_iam_binding_blast_radius_audit.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "IAM Policy Binding & Principal Blast-Radius Audit (Cost-Free Read-Only)", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "6 project IAM bindings inspected via cloudresourcemanager.GetIamPolicy | 1 primitive roles/editor binding flagged", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 80.0, 880.0, 405.0, "#161b22").set_attr("stroke", "#30363d");

  fn bind_row(y: float, role: string, member: string, scope: string, status: string, col: string) -> void {
    scene.rect(60.0, y, 840.0, 52.0, "#0d1117").set_attr("stroke", col);
    scene.text(80.0, y + 22.0, 13.5, role, "#e6edf3").set_attr("font-weight", "700");
    scene.text(80.0, y + 42.0, 11.5, member + "  (" + scope + ")", "#8b949e");
    scene.text(880.0, y + 32.0, 12.0, status, col).set_attr("text-anchor", "end").set_attr("font-weight", "700");
  }

  bind_row(98.0,  "roles/run.invoker",              "serviceAccount:checkout-runner@...", "Scoped Serverless Invoke", "LEAST PRIVILEGE", "#3fb950");
  bind_row(160.0, "roles/cloudsql.client",          "serviceAccount:checkout-runner@...", "Scoped Cloud SQL Client",  "LEAST PRIVILEGE", "#3fb950");
  bind_row(222.0, "roles/bigquery.dataEditor",      "serviceAccount:etl-pipeline@...",    "Scoped BQ Dataset Write",  "LEAST PRIVILEGE", "#3fb950");
  bind_row(284.0, "roles/storage.objectViewer",     "serviceAccount:etl-pipeline@...",    "Scoped GCS Read-Only",     "LEAST PRIVILEGE", "#3fb950");
  bind_row(346.0, "roles/run.admin",                "group:platform-eng@example.com",     "Human Group Admin Role",   "REVIEW (ADMIN)",  "#d29922");
  bind_row(408.0, "roles/editor",                   "serviceAccount:104928-compute@...",  "Default Compute SA",       "CRITICAL BLAST",  "#f85149");

  scene.render_png("images/32_iam_binding_blast_radius_audit.png", 960, 520, 1);
end _dsl_
savedsl(draw, "build/examples/32_iam_binding_blast_radius_audit_draw.dslb");
rd = system ${dsl_cli(draw)} --lmcode build/examples/32_iam_binding_blast_radius_audit_draw.dslb;
assert(rd.code == 0);
copy_file("images/32_iam_binding_blast_radius_audit.png", "docs/images/32_iam_binding_blast_radius_audit.png");
println("ok 32_iam_binding_blast_radius_audit - wrote images/32_iam_binding_blast_radius_audit.png");
println(split(r.stdout, "\n")[0]);
