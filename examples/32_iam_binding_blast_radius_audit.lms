# Cost-free read-only audit of project IAM policy bindings (iam_list_bindings) and service
# account privilege tiers (roles/editor vs scoped roles) without modifying IAM state ($0.00).
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  let bindings = gcp.iam_list_bindings();
  let sas = gcp.iam_list_service_accounts();
  assert_close(float(bindings.len()), 7.0, 0.01);
  assert_close(float(sas.len()), 5.0, 0.01);

  let editor_count = 0;
  let i = 0;
  while (i < bindings.len()) {
    if (str_contains(bindings.at(i), "roles/editor")) {
      editor_count = editor_count + 1;
    }
    i = i + 1;
  }
  assert_close(float(editor_count), 2.0, 0.01);
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("32_iam_binding_blast_radius_audit", "build/evidence/live-cost-32_iam_binding_blast_radius_audit.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 32_iam_binding_blast_radius_audit (lmgcp; lmdraw step awaits host migration)");
