# Cloud DNS managed zones, DNSSEC posture, and ephemeral zone + record set (A, TXT) CRUD lifecycle.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  gcp.set_run_id("dns-audit-15");

  let zones = gcp.dns_list_zones();
  assert_close(float(zones.len()), 2.0, 0.01);

  let z_pub = gcp.dns_get_zone("public-edge-zone");
  let z_priv = gcp.dns_get_zone("prod-internal-zone");
  check(z_pub.dnssec());
  check(z_priv.dnssec());

  let r_pub = gcp.dns_list_records("public-edge-zone");
  let r_priv = gcp.dns_list_records("prod-internal-zone");
  assert_close(float(r_pub.len()), 2.0, 0.01);
  assert_close(float(r_priv.len()), 3.0, 0.01);

  let z_demo = gcp.dns_create_zone("lmgcp-dns-zone", "sandbox.gcp-masked.example.", "public", true);
  check(z_demo.dnssec());

  let ok_a = gcp.dns_add_record("lmgcp-dns-zone", "api.sandbox.gcp-masked.example.", "A", 60, "34.120.99.10");
  let ok_t = gcp.dns_add_record("lmgcp-dns-zone", "api.sandbox.gcp-masked.example.", "TXT", 60, "v=lmgcp-verify");
  check(ok_a);
  check(ok_t);

  let r_demo = gcp.dns_list_records("lmgcp-dns-zone");
  assert_close(float(r_demo.len()), 2.0, 0.01);

  gcp.dns_delete_record("lmgcp-dns-zone", "api.sandbox.gcp-masked.example.", "TXT");
  gcp.dns_delete_record("lmgcp-dns-zone", "api.sandbox.gcp-masked.example.", "A");
  let ok_dz = gcp.dns_delete_zone("lmgcp-dns-zone");
  check(ok_dz);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);
  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("15_cloud_dns_zone_records", "build/evidence/live-cost-15_cloud_dns_zone_records.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 15_cloud_dns_zone_records (lmgcp; lmdraw step awaits host migration)");
