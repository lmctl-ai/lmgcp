# End-to-end observability pipeline combining Cloud Monitoring metric time series, structured
# Cloud Logging writes (with automatic secret redaction), SIEM log sink, and SLO alert policy.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  let lat = gcp.monitoring_query_series("run.googleapis.com/request_latencies_p95_ms", 6);
  let cpu = gcp.monitoring_query_series("cloudsql.googleapis.com/database/cpu/utilization", 6);
  assert_close(float(lat.len()), 6.0, 0.01);
  assert_close(float(cpu.len()), 6.0, 0.01);

  let lbl = str_map();
  lbl.set("service", "checkout-api");
  gcp.logging_write_entry("lmgcp-incident-log", "INFO", "request completed in 42ms", lbl);
  gcp.logging_write_entry("lmgcp-incident-log", "WARNING", "latency spike 162ms token=ya29.incidentSecret99", lbl);
  gcp.logging_write_entry("lmgcp-incident-log", "ERROR", "upstream timeout after 150ms", lbl);

  let sink = gcp.logging_create_sink("lmgcp-incident-sink", "bigquery.googleapis.com/projects/gcp-proj/datasets/sec_audit_logs", "severity>=WARNING");
  let pol = gcp.monitoring_create_alert_policy("lmgcp-incident-slo-alert", "run.googleapis.com/request_latencies_p95_ms", 150.0, 300);
  assert_close(pol.threshold(), 150.0, 0.01);

  let del = gcp.cleanup_ledger();
  assert_close(float(del), 2.0, 0.01);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);

  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("37_logging_monitoring_incident_pipeline", "build/evidence/live-cost-37_logging_monitoring_incident_pipeline.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 37_logging_monitoring_incident_pipeline (lmgcp; lmdraw step awaits host migration)");
