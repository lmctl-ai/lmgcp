# Deploys an ephemeral Cloud Run v2 service (lmgcp-checkout-api), shifts canary traffic
# progressively from 10% -> 50% -> 100%, verifies revision state, and cleans up via ledger.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  let svc = gcp.run_deploy_service("us-central1", "lmgcp-checkout-api", "us-central1-docker.pkg.dev/gcp-proj-****8f2a/prod-containers/checkout:v2.1.0", 1000, 512, 10);
  assert_close(float(svc.cpu_milli()), 1000.0, 0.01);
  assert_close(float(svc.memory_mb()), 512.0, 0.01);

  let ok1 = gcp.run_set_traffic_split("us-central1", "lmgcp-checkout-api", 90, 10);
  let s1 = gcp.run_get_service("us-central1", "lmgcp-checkout-api");
  assert_close(float(s1.canary_traffic_pct()), 10.0, 0.01);

  let ok2 = gcp.run_set_traffic_split("us-central1", "lmgcp-checkout-api", 50, 50);
  let s2 = gcp.run_get_service("us-central1", "lmgcp-checkout-api");
  assert_close(float(s2.canary_traffic_pct()), 50.0, 0.01);

  let ok3 = gcp.run_set_traffic_split("us-central1", "lmgcp-checkout-api", 0, 100);
  let s3 = gcp.run_get_service("us-central1", "lmgcp-checkout-api");
  assert_close(float(s3.canary_traffic_pct()), 100.0, 0.01);
  assert_close(float(s3.revision_count()), 4.0, 0.01);

  let del = gcp.cleanup_ledger();
  assert_close(float(del), 1.0, 0.01);
  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("06_cloud_run_canary_rollout", "build/evidence/live-cost-06_cloud_run_canary_rollout.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 06_cloud_run_canary_rollout (lmgcp; lmdraw step awaits host migration)");
