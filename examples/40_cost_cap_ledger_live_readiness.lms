# End-to-end cost-ledger and per-example cap readiness probe: provisions 6 ephemeral resources,
# tracks cumulative USD estimate at each step, enforces a tight cost cap refusal, and cleans up.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  gcp.set_run_id("cost-readiness-40");

  let vpc = gcp.network_create_vpc("lmgcp-probe-vpc", false);
  let c1 = gcp.estimated_cost_usd();

  let sub = gcp.network_create_subnet("us-central1", "lmgcp-probe-sub", "lmgcp-probe-vpc", "10.99.0.0/24", true);
  let c2 = gcp.estimated_cost_usd();

  let bkt = gcp.storage_create_bucket("lmgcp-probe-bkt", "US-CENTRAL1", "STANDARD");
  let c3 = gcp.estimated_cost_usd();

  let top = gcp.pubsub_create_topic("lmgcp-probe-topic");
  let c4 = gcp.estimated_cost_usd();

  let svc = gcp.run_deploy_service("us-central1", "lmgcp-probe-run", "us-central1-docker.pkg.dev/demo/probe:v1", 1000, 512, 5);
  let c5 = gcp.estimated_cost_usd();

  let vm = gcp.compute_create_instance("us-central1-a", "lmgcp-probe-vm", "e2-micro", "debian-12");
  let c6 = gcp.estimated_cost_usd();

  if (c6 <= c5 || c5 <= c4 || c4 <= c3) { assert_close(0.0, 1.0, 0.01); }

  # Tighten cap to $0.0050 so a db-custom-1-3840 SQL instance ($0.0105) is refused pre-flight
  gcp.set_cost_cap_usd(0.0050);
  let blocked_sql = gcp.sql_create_instance("lmgcp-probe-blocked-sql", "POSTGRES_15", "db-custom-1-3840", "us-central1", false);
  if (blocked_sql.state() != "" || !str_contains(gcp.last_error(), "cost cap exceeded")) {
    assert_close(0.0, 1.0, 0.01);
  }

  let del = gcp.cleanup_ledger();
  assert_close(float(del), 6.0, 0.01);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);

  let ok_ev = gcp.write_cost_evidence("40_cost_cap_ledger_live_readiness", "build/evidence/live-cost-40_cost_cap_ledger_live_readiness.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 40_cost_cap_ledger_live_readiness (lmgcp; lmdraw step awaits host migration)");
