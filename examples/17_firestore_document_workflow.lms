# Cloud Firestore document collection inspection & ephemeral session document CRUD workflow.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  gcp.set_run_id("firestore-crud-17");

  let cols = gcp.firestore_list_collections();
  assert_close(float(cols.len()), 1.0, 0.01);

  let ff = gcp.firestore_get_doc("feature_flags", "checkout_v2");
  check(ff.get("rollout_pct") == "25");

  let d1 = str_map().set("state", "ACTIVE").set("region", "us-central1").set("ttl_sec", "3600");
  let d2 = str_map().set("state", "COMMITTED").set("region", "us-east1").set("ttl_sec", "3600");
  check(gcp.firestore_put_doc("lmgcp_sessions", "lmgcp-sess-101", d1));
  check(gcp.firestore_put_doc("lmgcp_sessions", "lmgcp-sess-102", d2));

  let docs = gcp.firestore_list_docs("lmgcp_sessions");
  assert_close(float(docs.len()), 2.0, 0.01);

  let got = gcp.firestore_get_doc("lmgcp_sessions", "lmgcp-sess-102");
  check(got.get("state") == "COMMITTED");

  check(gcp.firestore_delete_doc("lmgcp_sessions", "lmgcp-sess-101"));
  check(gcp.firestore_delete_doc("lmgcp_sessions", "lmgcp-sess-102"));
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);
  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("17_firestore_document_workflow", "build/evidence/live-cost-17_firestore_document_workflow.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 17_firestore_document_workflow (lmgcp; lmdraw step awaits host migration)");
