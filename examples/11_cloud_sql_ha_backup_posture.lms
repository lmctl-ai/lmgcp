# Cloud SQL Regional HA, automated backup, PITR, SSL enforcement, and Public IP posture audit,
# plus ephemeral db-f1-micro instance creation and teardown.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  gcp.set_run_id("sql-posture-11");

  let db1 = gcp.sql_get_instance("prod-orders-pg15");
  let db2 = gcp.sql_get_instance("prod-ledger-pg15");
  let db3 = gcp.sql_get_instance("staging-reporting-mysql8");

  check(db1.ha_enabled());
  check(db1.pitr_enabled());
  check(db1.require_ssl());
  check(!db1.public_ip_enabled());

  check(db2.ha_enabled());
  check(!db3.ha_enabled());
  check(db3.public_ip_enabled());

  let demo = gcp.sql_create_instance("lmgcp-sql-demo", "POSTGRES_15", "db-f1-micro", "us-central1", false);
  check(demo.tier() == "db-f1-micro");
  check(demo.require_ssl());

  let ok_del = gcp.sql_delete_instance("lmgcp-sql-demo");
  check(ok_del);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);
  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("11_cloud_sql_ha_backup_posture", "build/evidence/live-cost-11_cloud_sql_ha_backup_posture.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 11_cloud_sql_ha_backup_posture (lmgcp; lmdraw step awaits host migration)");
