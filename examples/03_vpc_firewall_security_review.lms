# VPC Firewall / Security-Group ingress posture audit: detects 0.0.0.0/0 open-to-world SSH,
# RDP, and Postgres rules, checks firewall logging, and computes per-rule risk scores.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  let names = gcp.network_list_firewalls();
  assert_close(float(names.len()), 6.0, 0.01);

  let open_world = 0;
  let high_risk = 0;
  let i = 0;
  while (i < names.len()) {
    let fw = gcp.network_get_firewall(names.at(i));
    if (fw.is_open_to_world()) {
      open_world = open_world + 1;
    }
    if (fw.risk_score() >= 80) {
      high_risk = high_risk + 1;
    }
    i = i + 1;
  }
  assert_close(float(open_world), 3.0, 0.01);
  assert_close(float(high_risk), 3.0, 0.01);

  let ssh_fw = gcp.network_get_firewall("legacy-open-ssh-world");
  assert_close(float(ssh_fw.risk_score()), 100.0, 0.01);
  let iap_fw = gcp.network_get_firewall("prod-allow-iap-ssh");
  assert_close(float(iap_fw.risk_score()), 10.0, 0.01);
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("03_vpc_firewall_security_review", "build/evidence/live-cost-03_vpc_firewall_security_review.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 03_vpc_firewall_security_review (lmgcp; lmdraw step awaits host migration)");
