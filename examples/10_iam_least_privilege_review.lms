# IAM service account key hygiene & least-privilege audit: inspects 5 service accounts and
# 6 IAM policy bindings (metadata only, never key material), flagging user-managed keys >90d
# and primitive roles/editor bindings.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  let sas = gcp.iam_list_service_accounts();
  let bindings = gcp.iam_list_bindings();
  assert_close(float(sas.len()), 5.0, 0.01);
  assert_close(float(bindings.len()), 7.0, 0.01);

  let api_sa = gcp.iam_get_service_account("sa-prod-api@gcp-proj-masked.iam.gserviceaccount.com");
  assert_close(float(api_sa.user_managed_keys()), 0.0, 0.01);

  let leg_sa = gcp.iam_get_service_account("sa-legacy-ci@gcp-proj-masked.iam.gserviceaccount.com");
  assert_close(float(leg_sa.user_managed_keys()), 2.0, 0.01);
  assert_close(float(leg_sa.key_max_age_days()), 185.0, 0.01);

  let def_sa = gcp.iam_get_service_account("000000000000-compute@developer.gserviceaccount.com");
  check(def_sa.is_default_compute());
  assert_close(float(def_sa.key_max_age_days()), 310.0, 0.01);
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("10_iam_least_privilege_review", "build/evidence/live-cost-10_iam_least_privilege_review.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 10_iam_least_privilege_review (lmgcp; lmdraw step awaits host migration)");
