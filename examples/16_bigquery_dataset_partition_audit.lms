# BigQuery dataset & time-partitioned table audit + ephemeral dataset/table creation & teardown.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

p = _dsl_ cli="lmgcp" install="github:lmctl-ai/lmgcp@latest";
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  gcp.set_run_id("bq-audit-16");

  let dsets = gcp.bq_list_datasets();
  assert_close(float(dsets.len()), 2.0, 0.01);

  let ds1 = gcp.bq_get_dataset("commerce_warehouse");
  assert_close(float(ds1.default_expiration_days()), 365.0, 0.01);

  let t1 = gcp.bq_get_table("commerce_warehouse", "fact_orders");
  let t2 = gcp.bq_get_table("commerce_warehouse", "dim_products");
  let t3 = gcp.bq_get_table("security_telemetry", "vpc_flow_events");

  check(t1.partition_field() == "order_timestamp");
  assert_close(float(t1.row_count()), 4820000.0, 1.0);
  check(t2.partition_field() == "");
  check(t3.partition_field() == "event_time");

  let eds = gcp.bq_create_dataset("lmgcp_analytics_ds", "US");
  let etbl = gcp.bq_create_table("lmgcp_analytics_ds", "lmgcp_session_rollup", "session_id:STRING,ts:TIMESTAMP,latency_ms:INT64", "ts");
  check(etbl.partition_field() == "ts");

  let ok_t = gcp.bq_delete_table("lmgcp_analytics_ds", "lmgcp_session_rollup");
  let ok_d = gcp.bq_delete_dataset("lmgcp_analytics_ds");
  check(ok_t);
  check(ok_d);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);
end _dsl_
savedsl(p, "build/examples/16_bigquery_dataset_partition_audit.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/16_bigquery_dataset_partition_audit.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "BigQuery Dataset Expiration & Table Time-Partitioning Audit", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "Datasets: commerce_warehouse (365d TTL), security_telemetry (730d TTL) | Fact tables partitioned for scan pruning", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 82.0, 880.0, 290.0, "#161b22").set_attr("stroke", "#30363d");
  scene.text(60.0, 114.0, 15.0, "BigQuery Table Storage Footprint & Partition Pruning Posture", "#e6edf3").set_attr("font-weight", "700");

  fn bq_bar(y: float, name: string, w: float, col: string, info: string) -> void {
    scene.text(330.0, y + 20.0, 13.0, name, "#e6edf3").set_attr("text-anchor", "end").set_attr("font-weight", "600");
    scene.rect(345.0, y, w, 30.0, col);
    scene.text(355.0 + w, y + 20.0, 12.0, info, "#c9d1d9");
  }

  bq_bar(145.0, "security_telemetry.vpc_flow_events", 340.0, "#3fb950", "19.5M rows (4.1 GB) | HOUR(event_time) - PASS");
  bq_bar(210.0, "commerce_warehouse.fact_orders",     180.0, "#58a6ff", "4.82M rows (1.42 GB) | DAY(order_timestamp) - PASS");
  bq_bar(275.0, "commerce_warehouse.dim_products",     35.0, "#d29922", "84.5K rows (38 MB) | Unpartitioned Dimension");

  scene.rect(40.0, 390.0, 880.0, 96.0, "#161b22").set_attr("stroke", "#58a6ff");
  scene.text(60.0, 422.0, 14.0, "Ephemeral Warehouse Test: lmgcp_analytics_ds.lmgcp_session_rollup", "#58a6ff").set_attr("font-weight", "700");
  scene.text(60.0, 448.0, 12.5, "Created dataset (US) + DAY-partitioned table on 'ts' -> verified schema & partition_field() -> deleted both.", "#c9d1d9");
  scene.text(60.0, 472.0, 12.0, "Post-run ledger_count() == 0", "#3fb950");

  scene.render_png("images/16_bigquery_dataset_partition_audit.png", 960, 520, 1);
end _dsl_
savedsl(draw, "build/examples/16_bigquery_dataset_partition_audit_draw.dslb");
rd = system ${dsl_cli(draw)} --dsl build/examples/16_bigquery_dataset_partition_audit_draw.dslb;
assert(rd.code == 0);
copy_file("images/16_bigquery_dataset_partition_audit.png", "docs/images/16_bigquery_dataset_partition_audit.png");
println("ok 16_bigquery_dataset_partition_audit - wrote images/16_bigquery_dataset_partition_audit.png");
