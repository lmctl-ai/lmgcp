# Cloud Logging severity distribution & SIEM export sink routing + ephemeral sink CRUD.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  gcp.set_run_id("logging-sink-18");

  let lbl = str_map().set("component", "auth-gateway");
  let ok_w = gcp.logging_write_entry("lmgcp-audit-log", "WARNING", "Failed token check bearer ya29.secret_token_value", lbl);
  check(ok_w);

  let counts = gcp.logging_severity_counts();
  let n_info = str_to_int(counts.get("INFO"));
  let n_warn = str_to_int(counts.get("WARNING"));
  let n_err = str_to_int(counts.get("ERROR"));
  let n_crit = str_to_int(counts.get("CRITICAL"));

  assert_close(float(n_info), 94200.0, 1.0);
  assert_close(float(n_warn), 2181.0, 1.0);
  assert_close(float(n_err), 340.0, 1.0);
  assert_close(float(n_crit), 18.0, 1.0);

  let s = gcp.logging_create_sink("lmgcp-siem-sink", "pubsub.googleapis.com/projects/gcp-proj-masked/topics/security-audit-stream", "severity>=ERROR");
  check(!s.disabled());
  let sinks = gcp.logging_list_sinks();
  assert_close(float(sinks.len()), 4.0, 0.01);

  check(gcp.logging_delete_sink("lmgcp-siem-sink"));
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);
  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("18_cloud_logging_sink_routing", "build/evidence/live-cost-18_cloud_logging_sink_routing.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 18_cloud_logging_sink_routing (lmgcp; lmdraw step awaits host migration)");
