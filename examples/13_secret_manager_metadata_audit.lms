# Secret Manager metadata-only audit (never reads or writes secret payload bytes): checks
# replication policy, rotation period, CMEK encryption, and ephemeral secret metadata CRUD.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  gcp.set_run_id("secret-meta-13");

  let list = gcp.secrets_list();
  assert_close(float(list.len()), 5.0, 0.01);

  let s1 = gcp.secrets_get_metadata("prod-db-app-role-meta");
  let s2 = gcp.secrets_get_metadata("prod-stripe-webhook-meta");
  let s3 = gcp.secrets_get_metadata("legacy-partner-webhook-meta");

  assert_close(float(s1.rotation_period_days()), 30.0, 0.01);
  check(s1.cmek_enabled());
  assert_close(float(s2.rotation_period_days()), 45.0, 0.01);
  assert_close(float(s3.rotation_period_days()), 0.0, 0.01);

  let lbl = str_map().set("env", "sandbox").set("owner", "secops");
  let ephem = gcp.secrets_create_metadata("lmgcp-secret-meta-probe", "automatic", 30, lbl);
  assert_close(float(ephem.rotation_period_days()), 30.0, 0.01);

  let ok_del = gcp.secrets_delete("lmgcp-secret-meta-probe");
  check(ok_del);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);
  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("13_secret_manager_metadata_audit", "build/evidence/live-cost-13_secret_manager_metadata_audit.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 13_secret_manager_metadata_audit (lmgcp; lmdraw step awaits host migration)");
