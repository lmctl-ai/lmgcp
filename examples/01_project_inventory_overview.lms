# Multi-service GCP estate inventory across 16 resource types in masked project gcp-proj-****8f2a.
# Queries Compute, VPC, Subnets, Firewalls, GCS, Pub/Sub, Cloud Run, Cloud SQL, BigQuery, GKE,
# Artifact Registry, Cloud DNS, Secret Manager metadata, Log Sinks, and Alert Policies.
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp");
p = _lmcode_ s;
  let proj = gcp.masked_project();
  let mode = gcp.auth_mode();
  let inv = gcp.inventory_summary();

  let n_vm = str_to_int(inv.get("compute_instances"));
  let n_vpc = str_to_int(inv.get("vpc_networks"));
  let n_sub = str_to_int(inv.get("subnets"));
  let n_fw = str_to_int(inv.get("firewall_rules"));
  let n_bkt = str_to_int(inv.get("storage_buckets"));
  let n_top = str_to_int(inv.get("pubsub_topics"));
  let n_run = str_to_int(inv.get("cloud_run"));
  let n_sql = str_to_int(inv.get("sql_instances"));
  let n_gke = str_to_int(inv.get("gke_clusters"));
  let n_sec = str_to_int(inv.get("secrets_metadata"));

  assert_close(float(n_vm), 7.0, 0.01);
  assert_close(float(n_vpc), 3.0, 0.01);
  assert_close(float(n_sub), 5.0, 0.01);
  assert_close(float(n_fw), 6.0, 0.01);
  assert_close(float(n_bkt), 5.0, 0.01);
  assert_close(float(n_top), 3.0, 0.01);
  assert_close(float(n_run), 3.0, 0.01);
  assert_close(float(n_sql), 3.0, 0.01);
  assert_close(float(n_gke), 3.0, 0.01);
  assert_close(float(n_sec), 5.0, 0.01);

  let csv = "service,count\n"
    + "Compute VMs," + str(n_vm) + "\n"
    + "Firewall Rules," + str(n_fw) + "\n"
    + "VPC Subnets," + str(n_sub) + "\n"
    + "GCS Buckets," + str(n_bkt) + "\n"
    + "Secrets Meta," + str(n_sec) + "\n"
    + "VPC Networks," + str(n_vpc) + "\n"
    + "PubSub Topics," + str(n_top) + "\n"
    + "Cloud Run," + str(n_run) + "\n"
    + "Cloud SQL," + str(n_sql) + "\n"
    + "GKE Clusters," + str(n_gke) + "\n";
  file_write("build/examples/01_inventory.csv", csv);
  assert_close(gcp.estimated_cost_usd(), 0.0, 0.00001);
  let ok_ev = gcp.write_cost_evidence("01_project_inventory_overview", "build/evidence/live-cost-01_project_inventory_overview.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 01_project_inventory_overview (lmgcp; lmdraw step awaits host migration)");
