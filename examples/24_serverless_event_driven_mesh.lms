# End-to-end serverless event-driven mesh (GCS -> Pub/Sub -> Cloud Run -> BigQuery): provisions
# all 6 ephemeral components, exercises data flow, and tears down via cleanup_ledger().
mkdir("build/examples");
mkdir("images");
mkdir("docs/images");

s = load_schema(cli="lmgcp" install="github:lmctl-ai/lmgcp@latest");
p = _lmcode_ s;
  fn check(ok: bool) -> void { if (ok) { assert_close(1.0, 1.0, 0.01); } else { assert_close(0.0, 1.0, 0.01); } }
  gcp.set_run_id("serverless-mesh-24");

  let bkt = gcp.storage_create_bucket("lmgcp-mesh-ingest", "US-CENTRAL1", "STANDARD");
  let ok_put = gcp.storage_put_object("lmgcp-mesh-ingest", "events/batch-01.json", "{\"batch\":1,\"records\":250}", "application/json");
  check(ok_put);
  let sz = gcp.storage_object_size("lmgcp-mesh-ingest", "events/batch-01.json");
  assert_close(float(sz), 25.0, 0.01);

  let top = gcp.pubsub_create_topic("lmgcp-mesh-topic");
  let sub = gcp.pubsub_create_subscription("lmgcp-mesh-sub", "lmgcp-mesh-topic", 30, "");
  let attrs = str_map().set("bucket", "lmgcp-mesh-ingest").set("object", "events/batch-01.json");
  let mid = gcp.pubsub_publish("lmgcp-mesh-topic", "{\"event\":\"OBJECT_FINALIZE\",\"records\":250}", attrs);
  let pulled = gcp.pubsub_pull("lmgcp-mesh-sub", 5);
  assert_close(float(pulled.len()), 1.0, 0.01);

  let svc = gcp.run_deploy_service("us-central1", "lmgcp-mesh-processor", "us-central1-docker.pkg.dev/demo/mesh-proc:v1", 1000, 512, 4);
  assert_close(float(svc.max_instances()), 4.0, 0.01);

  let ds = gcp.bq_create_dataset("lmgcp_mesh_dw", "US");
  let tbl = gcp.bq_create_table("lmgcp_mesh_dw", "lmgcp_ingested_events", "batch:INT64,records:INT64,ingest_ts:TIMESTAMP", "ingest_ts");
  check(tbl.partition_field() == "ingest_ts");

  let cleaned = gcp.cleanup_ledger();
  assert_close(float(cleaned), 6.0, 0.01);
  assert_close(float(gcp.ledger_count()), 0.0, 0.01);
  let est_cost = gcp.estimated_cost_usd();
  if (est_cost <= 0.0 || est_cost > gcp.cost_cap_usd()) { assert_close(est_cost, -1.0, 0.0); }
  let ok_ev = gcp.write_cost_evidence("24_serverless_event_driven_mesh", "build/evidence/live-cost-24_serverless_event_driven_mesh.json");
  print(gcp.cost_report());
end _lmcode_
r = run_lmcode(p);
assert(r.ok, "lmgcp host failed");

println("ok 24_serverless_event_driven_mesh (lmgcp; lmdraw step awaits host migration)");
