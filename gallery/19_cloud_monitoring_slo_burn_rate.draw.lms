# Gallery scene restored from examples/19_cloud_monitoring_slo_burn_rate.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "Cloud Monitoring P95 Latency Series & SLO Alert Policy", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "Metric: run.googleapis.com/request_latencies_p95_ms (12 windows) | Ephemeral SLO Threshold: 80.0 ms", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 82.0, 880.0, 310.0, "#161b22").set_attr("stroke", "#30363d");

  let y_thresh = 360.0 - 80.0 * 2.4;
  scene.line(80.0, y_thresh, 890.0, y_thresh, "#ff7b72", 2.0);
  scene.text(880.0, y_thresh - 8.0, 11.5, "SLO Alert Threshold (80.0 ms)", "#ff7b72").set_attr("text-anchor", "end").set_attr("font-weight", "700");

  fn pt_bar(idx: int, ms: float) -> void {
    let x = 95.0 + float(idx) * 66.0;
    let h = ms * 2.4;
    let y = 360.0 - h;
    let col = "#3fb950";
    if (ms >= 80.0) {
      col = "#ff7b72";
    }
    scene.rect(x, y, 38.0, h, col);
    scene.text(x + 19.0, y - 8.0, 11.0, str(int(ms)) + "ms", "#e6edf3").set_attr("text-anchor", "middle");
    scene.text(x + 19.0, 378.0, 11.0, "t" + str(idx + 1), "#8b949e").set_attr("text-anchor", "middle");
  }

  pt_bar(0,  48.5);
  pt_bar(1,  51.2);
  pt_bar(2,  54.0);
  pt_bar(3,  62.8);
  pt_bar(4,  79.4);
  pt_bar(5,  92.1);
  pt_bar(6,  84.0);
  pt_bar(7,  68.3);
  pt_bar(8,  59.1);
  pt_bar(9,  53.7);
  pt_bar(10, 50.4);
  pt_bar(11, 49.0);

  scene.rect(40.0, 408.0, 880.0, 82.0, "#161b22").set_attr("stroke", "#58a6ff");
  scene.text(60.0, 438.0, 14.0, "SLO Burn Alert Verification: lmgcp-slo-latency-alert (Threshold 80.0ms / 180s window)", "#58a6ff").set_attr("font-weight", "700");
  scene.text(60.0, 466.0, 12.5, "Breach windows detected at t6 (92.1ms) and t7 (84.0ms) -> Policy created, verified & deleted cleanly.", "#c9d1d9");

  scene.render_png("images/19_cloud_monitoring_slo_burn_rate.png", 960, 520, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/19_cloud_monitoring_slo_burn_rate.png", "docs/images/19_cloud_monitoring_slo_burn_rate.png");
