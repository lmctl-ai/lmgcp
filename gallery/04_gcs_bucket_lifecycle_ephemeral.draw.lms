# Gallery scene restored from examples/04_gcs_bucket_lifecycle_ephemeral.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "GCS Ephemeral Bucket Lifecycle & Tiering Pipeline (lmgcp-lifecycle-demo)", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "Created with lmgcp_test label -> configured UBLA + Versioning + Lifecycle -> verified -> deleted cleanly", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(50.0, 110.0, 240.0, 160.0, "#161b22").set_attr("stroke", "#58a6ff").set_attr("stroke-width", "2");
  scene.text(170.0, 145.0, 15.0, "Day 0 - 30: STANDARD", "#58a6ff").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(170.0, 175.0, 12.0, "Hot ingestion & queries", "#c9d1d9").set_attr("text-anchor", "middle");
  scene.text(170.0, 200.0, 12.0, "2 objects (2026/10/*.json)", "#8b949e").set_attr("text-anchor", "middle");
  scene.text(170.0, 225.0, 12.0, "Uniform Access + Versioning", "#3fb950").set_attr("text-anchor", "middle");

  scene.arrow(295.0, 190.0, 355.0, 190.0, "#58a6ff", 2.5);
  scene.text(325.0, 178.0, 11.0, "Age >= 30d", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(360.0, 110.0, 240.0, 160.0, "#161b22").set_attr("stroke", "#d29922").set_attr("stroke-width", "2");
  scene.text(480.0, 145.0, 15.0, "Day 30 - 365: NEARLINE", "#d29922").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 175.0, 12.0, "SetStorageClass rule", "#c9d1d9").set_attr("text-anchor", "middle");
  scene.text(480.0, 200.0, 12.0, "50% lower storage cost", "#8b949e").set_attr("text-anchor", "middle");
  scene.text(480.0, 225.0, 12.0, "Public access: enforced", "#3fb950").set_attr("text-anchor", "middle");

  scene.arrow(605.0, 190.0, 665.0, 190.0, "#d29922", 2.5);
  scene.text(635.0, 178.0, 11.0, "Age >= 365d", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(670.0, 110.0, 240.0, 160.0, "#161b22").set_attr("stroke", "#ff7b72").set_attr("stroke-width", "2");
  scene.text(790.0, 145.0, 15.0, "Day 365+: EXPIRE", "#ff7b72").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(790.0, 175.0, 12.0, "Automatic Delete action", "#c9d1d9").set_attr("text-anchor", "middle");
  scene.text(790.0, 200.0, 12.0, "Zero retention bloat", "#8b949e").set_attr("text-anchor", "middle");
  scene.text(790.0, 225.0, 12.0, "Ledger teardown verified", "#3fb950").set_attr("text-anchor", "middle");

  scene.rect(50.0, 310.0, 860.0, 165.0, "#161b22").set_attr("stroke", "#30363d");
  scene.text(70.0, 340.0, 14.0, "Safety & Run Ledger Verification", "#3fb950").set_attr("font-weight", "700");
  scene.text(70.0, 370.0, 12.5, "1. Prefix check passed: bucket name 'lmgcp-lifecycle-demo' starts with 'lmgcp-'", "#c9d1d9");
  scene.text(70.0, 396.0, 12.5, "2. Mandatory label attached: lmgcp_test=run-20261024, lmgcp_created_at=1761350400", "#c9d1d9");
  scene.text(70.0, 422.0, 12.5, "3. Object operations restricted to run-owned bucket; baseline buckets remain untouched", "#c9d1d9");
  scene.text(70.0, 448.0, 12.5, "4. cleanup_ledger() deleted 1 bucket; post-run ledger_count() == 0", "#58a6ff");

  scene.render_png("images/04_gcs_bucket_lifecycle_ephemeral.png", 960, 520, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/04_gcs_bucket_lifecycle_ephemeral.png", "docs/images/04_gcs_bucket_lifecycle_ephemeral.png");
