# Gallery scene restored from examples/29_gcs_object_retention_versioning_lab.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "GCS Partitioned Object Ingestion, Redaction & Versioning Lab", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "Bucket: lmgcp-telemetry-lake | 4 objects written -> OAuth token redacted -> tmp object pruned -> bucket deleted", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 82.0, 880.0, 395.0, "#161b22").set_attr("stroke", "#30363d");

  fn obj_box(y: float, key: string, ctype: string, status: string, detail: string, col: string) -> void {
    scene.rect(65.0, y, 830.0, 72.0, "#0d1117").set_attr("stroke", col);
    scene.text(85.0, y + 28.0, 14.0, key, "#e6edf3").set_attr("font-weight", "700");
    scene.text(85.0, y + 52.0, 12.0, "Content-Type: " + ctype + "  |  " + detail, "#8b949e");
    scene.text(875.0, y + 40.0, 12.5, status, col).set_attr("text-anchor", "end").set_attr("font-weight", "700");
  }

  obj_box(105.0, "raw/2026-10-24/shard-00.jsonl",    "application/json", "VERIFIED (1,200 rows)", "Prefix filter raw/2026-10-24/ matched", "#3fb950");
  obj_box(192.0, "raw/2026-10-24/shard-01.jsonl",    "application/json", "TOKEN REDACTED",        "ya29.secretAbc12345 -> ya29.[REDACTED]", "#58a6ff");
  obj_box(279.0, "curated/2026-10-24/summary.csv",   "text/csv",         "VERIFIED (p95=38.4ms)", "Readback & byte-size check passed",     "#a371f7");
  obj_box(366.0, "tmp/scratch.txt",                  "text/plain",       "PRUNED & CLEANED",      "Deleted via storage_delete_object()",   "#d29922");

  scene.render_png("images/29_gcs_object_retention_versioning_lab.png", 960, 520, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/29_gcs_object_retention_versioning_lab.png", "docs/images/29_gcs_object_retention_versioning_lab.png");
