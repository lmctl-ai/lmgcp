# Gallery scene restored from examples/03_vpc_firewall_security_review.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 560, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "VPC Firewall Ingress Audit & Risk Scoring (6 Rules Across 3 VPCs)", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "3 critical 0.0.0.0/0 exposures flagged (SSH:22, RDP:3389, Postgres:5432) vs 3 hardened prod rules", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(35.0, 78.0, 890.0, 445.0, "#161b22").set_attr("stroke", "#30363d");

  fn fw_row(y: float, name: string, vpc: string, cidr: string, port: string, logs: string, score: int, col: string) -> void {
    scene.rect(55.0, y, 850.0, 54.0, "#0d1117").set_attr("stroke", "#30363d");
    scene.text(70.0, y + 22.0, 13.5, name, "#e6edf3").set_attr("font-weight", "700");
    scene.text(70.0, y + 42.0, 11.5, "VPC: " + vpc + "  |  Source: " + cidr + "  |  Port: " + port + "  |  Flow Logs: " + logs, "#8b949e");
    let bw = float(score) * 2.4;
    scene.rect(610.0, y + 14.0, 240.0, 24.0, "#21262d");
    scene.rect(610.0, y + 14.0, bw, 24.0, col);
    scene.text(862.0, y + 31.0, 13.0, str(score) + "/100", col).set_attr("font-weight", "700");
  }

  fw_row(95.0,  "legacy-open-ssh-world",    "staging-vpc",   "0.0.0.0/0",                  "tcp:22",        "OFF", 100, "#ff7b72");
  fw_row(162.0, "legacy-open-rdp-world",    "staging-vpc",   "0.0.0.0/0",                  "tcp:3389",      "OFF", 100, "#ff7b72");
  fw_row(229.0, "analytics-open-postgres",  "analytics-vpc", "0.0.0.0/0",                  "tcp:5432",      "OFF", 95,  "#f0883e");
  fw_row(296.0, "prod-allow-iap-ssh",       "prod-vpc",      "35.235.240.0/20 (Google IAP)", "tcp:22",      "ON",  10,  "#3fb950");
  fw_row(363.0, "prod-allow-lb-healthcheck","prod-vpc",      "35.191.0.0/16, 130.211.0.0/22", "tcp:443",    "ON",  10,  "#3fb950");
  fw_row(430.0, "prod-allow-internal",      "prod-vpc",      "10.10.0.0/16",               "tcp:8080,8443", "ON",  10,  "#3fb950");

  scene.render_png("images/03_vpc_firewall_security_review.png", 960, 560, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/03_vpc_firewall_security_review.png", "docs/images/03_vpc_firewall_security_review.png");
