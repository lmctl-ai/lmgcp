# Gallery scene restored from examples/13_secret_manager_metadata_audit.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 540, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "Secret Manager Metadata Audit (Zero Payload Access Guarantee)", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "AccessSecretVersion is omitted from lmgcp by design | Only rotation, replication & CMEK metadata inspected", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 80.0, 880.0, 340.0, "#161b22").set_attr("stroke", "#30363d");

  fn sec_row(y: float, name: string, repl: string, rot: string, cmek: string, status: string, col: string) -> void {
    scene.rect(58.0, y, 844.0, 50.0, "#0d1117").set_attr("stroke", "#30363d");
    scene.text(74.0, y + 30.0, 13.0, name, "#e6edf3").set_attr("font-weight", "700");
    scene.text(320.0, y + 30.0, 12.0, repl, "#8b949e");
    scene.text(535.0, y + 30.0, 12.0, rot, col);
    scene.text(685.0, y + 30.0, 12.0, cmek, "#58a6ff");
    scene.text(795.0, y + 30.0, 12.5, status, col).set_attr("font-weight", "700");
  }

  sec_row(98.0,  "prod-db-app-role-meta",       "user-managed-multi", "30d (6 vers)", "CMEK: ON",  "COMPLIANT", "#3fb950");
  sec_row(158.0, "prod-jwt-signing-meta",       "automatic (global)", "30d (8 vers)", "CMEK: ON",  "COMPLIANT", "#3fb950");
  sec_row(218.0, "prod-stripe-webhook-meta",    "user-managed-multi", "45d (4 vers)", "CMEK: ON",  "COMPLIANT", "#3fb950");
  sec_row(278.0, "staging-oauth-client-meta",   "automatic (global)", "90d (2 vers)", "DEFAULT",   "WARN",      "#d29922");
  sec_row(338.0, "legacy-partner-webhook-meta", "automatic (global)", "UNROTATED!",   "DEFAULT",   "FAIL (0d)", "#ff7b72");

  scene.rect(40.0, 436.0, 880.0, 78.0, "#161b22").set_attr("stroke", "#3fb950");
  scene.text(60.0, 466.0, 13.5, "Ephemeral Metadata Lifecycle: lmgcp-secret-meta-probe (30d rotation, zero secret payload)", "#3fb950").set_attr("font-weight", "700");
  scene.text(60.0, 492.0, 12.0, "Created metadata container with lmgcp_test label -> verified rotation_period_days()==30 -> deleted cleanly.", "#c9d1d9");

  scene.render_png("images/13_secret_manager_metadata_audit.png", 960, 540, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/13_secret_manager_metadata_audit.png", "docs/images/13_secret_manager_metadata_audit.png");
