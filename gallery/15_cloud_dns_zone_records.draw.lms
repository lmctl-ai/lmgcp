# Gallery scene restored from examples/15_cloud_dns_zone_records.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "Cloud DNS Managed Zones, DNSSEC Posture & Record Set Lifecycle", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "Split-Horizon DNS (Public Edge + Private VPC) with DNSSEC=ON | Ephemeral zone + RRset CRUD verified", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 82.0, 425.0, 290.0, "#161b22").set_attr("stroke", "#3fb950").set_attr("stroke-width", "2");
  scene.text(60.0, 114.0, 15.5, "public-edge-zone (edge.gcp-masked.example.)", "#3fb950").set_attr("font-weight", "700");
  scene.text(60.0, 138.0, 12.0, "Visibility: PUBLIC  |  DNSSEC: ON  |  Records: 2", "#8b949e");
  scene.rect(60.0, 160.0, 385.0, 46.0, "#0d1117").set_attr("stroke", "#30363d");
  scene.text(74.0, 188.0, 12.0, "edge.gcp-masked.example.      A    300s  34.110.200.10", "#c9d1d9");
  scene.rect(60.0, 218.0, 385.0, 46.0, "#0d1117").set_attr("stroke", "#30363d");
  scene.text(74.0, 246.0, 12.0, "_dmarc.edge.gcp-masked...     TXT  3600s v=DMARC1; p=reject", "#c9d1d9");
  scene.text(60.0, 340.0, 12.5, "Status: DNSSEC + DMARC Reject Policy Enforced", "#3fb950");

  scene.rect(495.0, 82.0, 425.0, 290.0, "#161b22").set_attr("stroke", "#58a6ff").set_attr("stroke-width", "2");
  scene.text(515.0, 114.0, 15.5, "prod-internal-zone (internal.gcp-masked...)", "#58a6ff").set_attr("font-weight", "700");
  scene.text(515.0, 138.0, 12.0, "Visibility: PRIVATE (prod-vpc)  |  Records: 3", "#8b949e");
  scene.rect(515.0, 160.0, 385.0, 42.0, "#0d1117").set_attr("stroke", "#30363d");
  scene.text(529.0, 186.0, 12.0, "api.internal...   A      60s   10.10.1.11, 10.10.1.12", "#c9d1d9");
  scene.rect(515.0, 210.0, 385.0, 42.0, "#0d1117").set_attr("stroke", "#30363d");
  scene.text(529.0, 236.0, 12.0, "db.internal...    A      60s   10.10.16.10", "#c9d1d9");
  scene.rect(515.0, 260.0, 385.0, 42.0, "#0d1117").set_attr("stroke", "#30363d");
  scene.text(529.0, 286.0, 12.0, "cache.internal... CNAME  120s  redis.internal...", "#c9d1d9");
  scene.text(515.0, 340.0, 12.5, "Status: Private Split-Horizon Resolution Active", "#58a6ff");

  scene.rect(40.0, 390.0, 880.0, 96.0, "#161b22").set_attr("stroke", "#a371f7");
  scene.text(60.0, 422.0, 14.0, "Ephemeral DNS CRUD Verified: lmgcp-dns-zone (sandbox.gcp-masked.example.)", "#a371f7").set_attr("font-weight", "700");
  scene.text(60.0, 448.0, 12.5, "1. Created zone with DNSSEC=true -> 2. Added A + TXT records -> 3. Listed 2 records -> 4. Deleted records & zone.", "#c9d1d9");
  scene.text(60.0, 472.0, 12.0, "Post-run ledger_count() == 0", "#3fb950");

  scene.render_png("images/15_cloud_dns_zone_records.png", 960, 520, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/15_cloud_dns_zone_records.png", "docs/images/15_cloud_dns_zone_records.png");
