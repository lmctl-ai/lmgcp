# Gallery scene restored from examples/35_kms_multi_keyring_envelope_audit.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "Cloud KMS Multi-KeyRing Envelope Encryption & Rotation Audit", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "KeyRing: prod-ring (us-central1) | 3 baseline keys + 2 ephemeral HSM keys compared against 90-day CIS threshold", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 82.0, 880.0, 400.0, "#161b22").set_attr("stroke", "#30363d");

  fn kms_row(y: float, name: string, rot: string, prot: string, verdict: string, col: string) -> void {
    scene.rect(60.0, y, 840.0, 58.0, "#0d1117").set_attr("stroke", col);
    scene.text(80.0, y + 24.0, 14.0, name, "#e6edf3").set_attr("font-weight", "700");
    scene.text(80.0, y + 45.0, 12.0, "ProtectionLevel: " + prot + "  |  Rotation Period: " + rot + " days", "#8b949e");
    scene.text(880.0, y + 35.0, 12.5, verdict, col).set_attr("text-anchor", "end").set_attr("font-weight", "700");
  }

  kms_row(100.0, "lmgcp-envelope-dek-01", "30", "HSM", "PASS (30d <= 90d, EPHEMERAL)", "#3fb950");
  kms_row(172.0, "lmgcp-artifact-sign-01","60", "HSM", "PASS (60d <= 90d, EPHEMERAL)", "#58a6ff");
  kms_row(244.0, "gcs-cmek-key",          "90", "HSM", "PASS (90d <= 90d, BASELINE)",  "#3fb950");
  kms_row(316.0, "sql-cmek-key",          "90", "HSM", "PASS (90d <= 90d, BASELINE)",  "#3fb950");
  kms_row(388.0, "legacy-manual-key",     "365","HSM", "FAIL (365d > 90d CIS LIMIT)",  "#f85149");

  scene.render_png("images/35_kms_multi_keyring_envelope_audit.png", 960, 520, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/35_kms_multi_keyring_envelope_audit.png", "docs/images/35_kms_multi_keyring_envelope_audit.png");
