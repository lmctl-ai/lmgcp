# Gallery scene restored from examples/27_compute_disk_snapshot_inventory.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 540, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "Compute Persistent Disk & Boot Volume Inventory (850 GB Total)", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "Cost-free read-only inspection across us-central1-a, us-central1-b, and us-east1-b | 5/7 VMs deletion-protected", "#8b949e").set_attr("text-anchor", "middle");

  scene.rect(40.0, 78.0, 880.0, 425.0, "#161b22").set_attr("stroke", "#30363d");

  fn disk_row(y: float, vm: string, zone: string, shape: string, gb: int, prot: string, col: string) -> void {
    scene.rect(60.0, y, 840.0, 46.0, "#0d1117").set_attr("stroke", "#30363d");
    scene.text(78.0, y + 28.0, 13.0, vm, "#e6edf3").set_attr("font-weight", "700");
    scene.text(280.0, y + 28.0, 12.0, zone + "  (" + shape + ")", "#8b949e");
    let w = float(gb) * 1.1;
    scene.rect(490.0, y + 12.0, w, 22.0, col);
    scene.text(500.0 + w, y + 28.0, 12.0, str(gb) + " GB", "#e6edf3").set_attr("font-weight", "600");
    scene.text(880.0, y + 28.0, 11.5, prot, col).set_attr("text-anchor", "end").set_attr("font-weight", "700");
  }

  disk_row(95.0,  "prod-db-replica-01",   "us-central1-b", "n2-highmem-4",  250, "PROTECTED",   "#3fb950");
  disk_row(151.0, "prod-etl-runner-01",   "us-central1-a", "n2-standard-8", 200, "PROTECTED",   "#3fb950");
  disk_row(207.0, "prod-api-gw-01",       "us-central1-a", "e2-standard-4", 100, "PROTECTED",   "#58a6ff");
  disk_row(263.0, "prod-api-gw-02",       "us-central1-b", "e2-standard-4", 100, "PROTECTED",   "#58a6ff");
  disk_row(319.0, "dr-standby-gw-01",     "us-east1-b",    "e2-standard-2", 80,  "PROTECTED",   "#a371f7");
  disk_row(375.0, "staging-worker-01",    "us-central1-a", "e2-medium",     50,  "UNPROTECTED", "#d29922");
  disk_row(431.0, "dev-Experiment-untagged","us-east1-b",  "e2-small",      70,  "UNPROTECTED", "#f85149");

  scene.render_png("images/27_compute_disk_snapshot_inventory.png", 960, 540, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/27_compute_disk_snapshot_inventory.png", "docs/images/27_compute_disk_snapshot_inventory.png");
