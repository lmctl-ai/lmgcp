# Gallery scene restored from examples/24_serverless_event_driven_mesh.lms (pre-migration), content unchanged below.
# Inputs: optional JSON metrics path in ARGV[0]; the scene uses its committed baseline literals.
s = load_schema(cli="lmdraw" install="github:lmctl-ai/lmdraw@latest");
p = _lmcode_ s;
  scene.canvas(960, 520, "#0d1117");
  scene.text(480.0, 34.0, 20.0, "Serverless Event-Driven Mesh (GCS -> Pub/Sub -> Cloud Run -> BigQuery)", "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  scene.text(480.0, 56.0, 12.5, "6 Ephemeral Resources Provisioned, Exercised End-to-End & Torn Down via cleanup_ledger()", "#8b949e").set_attr("text-anchor", "middle");

  fn stage_box(x: float, step: string, name: string, detail1: string, detail2: string, col: string) -> void {
    scene.rect(x, 110.0, 195.0, 190.0, "#161b22").set_attr("stroke", col).set_attr("stroke-width", "2");
    scene.text(x + 97.5, 144.0, 14.5, step, col).set_attr("text-anchor", "middle").set_attr("font-weight", "700");
    scene.text(x + 97.5, 174.0, 13.0, name, "#e6edf3").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
    scene.text(x + 97.5, 206.0, 11.5, detail1, "#c9d1d9").set_attr("text-anchor", "middle");
    scene.text(x + 97.5, 232.0, 11.5, detail2, "#8b949e").set_attr("text-anchor", "middle");
    scene.rect(x + 22.0, 252.0, 151.0, 30.0, "#0d1117").set_attr("stroke", col);
    scene.text(x + 97.5, 272.0, 11.5, "VERIFIED & CLEANED", col).set_attr("text-anchor", "middle").set_attr("font-weight", "700");
  }

  scene.arrow(235.0, 205.0, 270.0, 205.0, "#58a6ff", 2.5);
  scene.arrow(465.0, 205.0, 500.0, 205.0, "#a371f7", 2.5);
  scene.arrow(695.0, 205.0, 730.0, 205.0, "#3fb950", 2.5);

  stage_box(40.0,  "1. Cloud Storage", "lmgcp-mesh-ingest",    "events/batch-01.json", "25 bytes uploaded",   "#58a6ff");
  stage_box(270.0, "2. Cloud Pub/Sub", "lmgcp-mesh-topic",     "Sub: lmgcp-mesh-sub",  "1 event delivered",   "#a371f7");
  stage_box(500.0, "3. Cloud Run v2",  "lmgcp-mesh-processor", "1000m CPU / 512 MiB",  "0..4 auto-scaling",   "#3fb950");
  stage_box(730.0, "4. BigQuery DW",   "lmgcp_mesh_dw",        "lmgcp_ingested_events","DAY(ingest_ts) part", "#f0883e");

  scene.rect(40.0, 332.0, 885.0, 150.0, "#161b22").set_attr("stroke", "#30363d");
  scene.text(60.0, 364.0, 14.5, "End-to-End Pipeline & Ledger Verification", "#e6edf3").set_attr("font-weight", "700");
  scene.text(60.0, 394.0, 12.5, "1. Uploaded JSON batch to GCS bucket lmgcp-mesh-ingest and verified payload size (25 bytes)", "#c9d1d9");
  scene.text(60.0, 420.0, 12.5, "2. Published OBJECT_FINALIZE notification to lmgcp-mesh-topic and pulled from lmgcp-mesh-sub", "#c9d1d9");
  scene.text(60.0, 446.0, 12.5, "3. Deployed Cloud Run worker + BigQuery partitioned sink table, then cleaned all 6 resources (ledger=0)", "#3fb950");

  scene.render_png("images/24_serverless_event_driven_mesh.png", 960, 520, 1);
end _lmcode_
r = run_lmcode(p, {args: ARGV});
assert(r.ok, "lmdraw host failed");
copy_file("images/24_serverless_event_driven_mesh.png", "docs/images/24_serverless_event_driven_mesh.png");
