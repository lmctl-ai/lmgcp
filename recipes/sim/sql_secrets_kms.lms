# Access: Write to lmgcp's in-process fake GCP server (Cloud SQL, Secret Manager and KMS are not served by gcpsim 0.2.x)
# What: Data layer for a web app: a PostgreSQL Cloud SQL instance on a sandbox tier, database-password secret metadata with rotation, a KMS key ring and rotating key, then teardown
# When: Planning the stateful parts of a site; values of secrets are never read (metadata only)
# Emulator: lmgcp in-process fake (default --endpoint fake)
# Run: lmscript recipes/sim/sql_secrets_kms.lms
# Arguments: --endpoint fake|URL --host PATH --run ID --out DIR
# Cleanup: gcp.cleanup_ledger() deletes the SQL instance, secret and key ring entries it owns
import "./lib/common.lms";

o = sim_options("sql_secrets_kms", {endpoint: {type: "string", default: getenv("LMGCP_FAKE_ENDPOINT", "fake"), description: "'fake' (in-process GCP server) or a gcpsim origin"}}, "usage: sql_secrets_kms.lms [--endpoint fake|URL] [--host PATH]");
sql = "lmgcp-sim-db-" + o.run;
secret = "lmgcp-sim-db-password-" + o.run;
ring = "lmgcp-sim-ring-" + o.run;
key = "lmgcp-sim-app-key-" + o.run;

program = _lmcode_ cli="lmgcp";
  gcp.set_cost_cap_usd(0.25);
  let db = gcp.sql_create_instance(${sql}, "POSTGRES_15", "db-f1-micro", "us-central1", false);
  let sql_error = gcp.last_error();
  let sec = gcp.secrets_create_metadata(${secret}, "automatic", 90, str_map().set("site", "lmgcp-sim").set("purpose", "db-password"));
  let sec_meta = gcp.secrets_get_metadata(${secret});
  let k = gcp.kms_create_key("us-central1", ${ring}, ${key}, "ENCRYPT_DECRYPT", 90);
  let kms_error = gcp.last_error();
  let keys = gcp.kms_list_keys("us-central1", ${ring});
  let secrets = gcp.secrets_list();
  let sqls = gcp.sql_list_instances();
  let cleaned = gcp.cleanup_ledger();
  lmcode_return_put("sql", db.name());
  lmcode_return_put("sql_error", sql_error);
  lmcode_return_put("db_version", db.db_version());
  lmcode_return_put("tier", db.tier());
  lmcode_return_put("state", db.state());
  lmcode_return_put("backup", db.backup_enabled());
  lmcode_return_put("public_ip", db.public_ip_enabled());
  lmcode_return_put("secret", sec.name());
  lmcode_return_put("secret_rotation_days", sec_meta.rotation_period_days());
  lmcode_return_put("secret_replication", sec_meta.replication_policy());
  lmcode_return_put("key", k.name());
  lmcode_return_put("kms_error", kms_error);
  lmcode_return_put("key_purpose", k.purpose());
  lmcode_return_put("key_rotation_days", k.rotation_days());
  lmcode_return_put("keys_seen", keys.contains(${key}));
  lmcode_return_put("secrets_seen", secrets.contains(${secret}));
  lmcode_return_put("sqls_seen", sqls.contains(${sql}));
  lmcode_return_put("cleaned", cleaned);
  lmcode_return_put("ledger_after", gcp.ledger_count());
  lmcode_return_put("cost", gcp.cost_report());
end _lmcode_

r = sim_run(program, gcp_native_command(o)).result;
println(r.cost);
assert(r.sql_error == "" && r.state == "RUNNABLE", "the SQL instance must be created: " + r.sql_error);
assert(r.kms_error == "" && r.keys_seen, "the KMS key must exist in its ring: " + r.kms_error);
assert(r.secret_rotation_days == 90 && r.secrets_seen, "secret metadata must record the rotation period");
assert(r.sqls_seen && r.ledger_after == 0 && r.cleaned >= 3, "inventory must list the instance and cleanup must remove the owned resources");
println(r.sql + " (" + r.db_version + ", " + r.tier + ", backups=" + str(r.backup) + ", public ip=" + str(r.public_ip) + "); secret " + r.secret + " rotates every " + str(r.secret_rotation_days) + "d (" + r.secret_replication + "); key " + r.key + " " + r.key_purpose + " rotates every " + str(r.key_rotation_days) + "d");
sim_report(o, {target: o.target, host: "lmgcp", data_layer: r});
sim_pass(o);
